(1 row)

                                                  QUERY PLAN                                                   
---------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using hf_w on hf
         Order By: ((d <=> '(''a'' | ''b'')'::wquery) AND (d <=> '''c'''::wquery) AND (d <~> '{1,1}'::real[]))
(3 rows)

-- 1.  The hint reaches the fused scan: fused score() calls, hint off vs on.
CREATE TEMP TABLE work (shape text, lim int, arm text, passes bigint, scores bigint);
CREATE FUNCTION hf_work(shape text, lim int, arm text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  EXECUTE format('SET pg_weave.limit_hint = %s', arm);
  PERFORM weave_fuse_stats_reset();
  EXECUTE format('SELECT count(*) FROM (%s) s', hf_q(shape, 'LIMIT ' || lim));
  INSERT INTO work SELECT shape, lim, arm, passes, scores FROM weave_fuse_stats();
  RESET pg_weave.limit_hint;
END $$;
DO $$ DECLARE s text; l int; a text; BEGIN
  FOREACH s IN ARRAY ARRAY['lv', 'vl', 'll'] LOOP FOREACH l IN ARRAY ARRAY[10, 100] LOOP
    FOREACH a IN ARRAY ARRAY['off', 'on'] LOOP PERFORM hf_work(s, l, a); END LOOP;
  END LOOP; END LOOP; END $$;
SELECT w0.shape, w0.lim, w0.passes > 0 AND w1.passes > 0 AS fused_scan_ran,
       CASE WHEN w0.lim = 10 THEN w1.scores < w0.scores ELSE w1.scores <= w0.scores END
         AS less_at_10_never_more_at_100
  FROM work w0 JOIN work w1 ON w1.shape = w0.shape AND w1.lim = w0.lim AND w1.arm = 'on'
 WHERE w0.arm = 'off' ORDER BY 1, 2;
 shape | lim | fused_scan_ran | less_at_10_never_more_at_100 
-------+-----+----------------+------------------------------
 ll    |  10 | t              | t
 ll    | 100 | t              | t
 lv    |  10 | t              | t
 lv    | 100 | t              | t
 vl    |  10 | t              | t
 vl    | 100 | t              | t
(6 rows)

-- 2.  Exact answers.  hr_lv / hr_ll: every ranked row's fused score from the oracle
-- (`vl` sums the same two terms, and a two-term sum is commutative).  A returned
-- sequence is right when its ranked rows' scores, in output order, equal the exact
-- top window of the admitted rows sorted descending (order AND multiset in one
-- comparison, to 1e-6), every row is distinct, and the unranked rows -- NULL vectors, padded
-- at a NULL fuse() -- all come after every ranked one.
CREATE TEMP TABLE hr_lv (rowtid tid, score float8, id int);
CREATE TEMP TABLE hr_ll (rowtid tid, score float8, id int);
CREATE TEMP TABLE hf_got (rn bigint, rowtid tid);
CREATE FUNCTION hf_ref() RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  TRUNCATE hr_lv, hr_ll;
  INSERT INTO hr_lv SELECT s.ctid, s.score, h.id
    FROM weave_fuse_search('hf_w', ARRAY['a | b | c'::wquery], ARRAY['[0.3,0.6,0.2,0.9]'::wvec],
                           NULL, 100000) s JOIN hf h ON h.ctid = s.ctid;
  INSERT INTO hr_ll SELECT s.ctid, s.score, h.id
    FROM weave_fuse_search('hf_w', ARRAY['a | b'::wquery, 'c'::wquery], NULL, NULL, 100000) s
    JOIN hf h ON h.ctid = s.ctid;
END $$;
CREATE FUNCTION hf_chk(q text, ref text, n int, filt text, off int DEFAULT 0) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE got float8[]; want float8[]; nrow int; ndist int; tail_ok bool; nunranked int;
BEGIN
  TRUNCATE hf_got;
  EXECUTE format('INSERT INTO hf_got SELECT row_number() OVER (), rowtid FROM (%s) x', q);
  SELECT count(*), count(DISTINCT rowtid) INTO nrow, ndist FROM hf_got;
  EXECUTE format('SELECT array_agg(r.score ORDER BY g.rn) FROM hf_got g JOIN %I r USING (rowtid)', ref)
    INTO got;
  EXECUTE format($f$SELECT count(*) FILTER (WHERE r.rowtid IS NULL),
      coalesce(bool_and(h.v IS NULL) FILTER (WHERE r.rowtid IS NULL), true)
      AND coalesce(min(g.rn) FILTER (WHERE r.rowtid IS NULL)
                   > max(g.rn) FILTER (WHERE r.rowtid IS NOT NULL), true)
      FROM hf_got g JOIN hf h ON h.ctid = g.rowtid LEFT JOIN %I r USING (rowtid)$f$, ref)
    INTO nunranked, tail_ok;
  EXECUTE format('SELECT array_agg(score ORDER BY score DESC) FROM (SELECT score FROM %I WHERE %s ORDER BY score DESC LIMIT %s OFFSET %s) z',
                 ref, filt, n, off) INTO want;
  -- 1e-6 relative: `vl` sums its channels in another order than the oracle
  RETURN format('n=%s distinct=%s padded=%s tail_ok=%s exact=%s', nrow, ndist, nunranked, tail_ok,
    array_length(got, 1) IS NOT DISTINCT FROM array_length(want, 1) AND
    coalesce((SELECT bool_and(abs(got[i] - want[i]) <= 1e-6 * (1 + abs(want[i])))
                FROM generate_subscripts(want, 1) i), true));
END $$;
CREATE FUNCTION hf_all() RETURNS TABLE (shape text, win text, result text) LANGUAGE plpgsql AS $$
DECLARE s text; ref text;
BEGIN
  PERFORM hf_ref();
  FOREACH s IN ARRAY ARRAY['lv', 'vl', 'll'] LOOP
    ref := CASE s WHEN 'll' THEN 'hr_ll' ELSE 'hr_lv' END;
    shape := s;
    win := 'LIMIT 10';         result := hf_chk(hf_q(s, 'LIMIT 10'), ref, 10, 'true'); RETURN NEXT;
    win := 'LIMIT 1';          result := hf_chk(hf_q(s, 'LIMIT 1'), ref, 1, 'true'); RETURN NEXT;
    win := 'LIMIT 3 OFFSET 7'; result := hf_chk(hf_q(s, 'LIMIT 3 OFFSET 7'), ref, 3, 'true', 7); RETURN NEXT;
    win := 'LIMIT 10 OFFSET 200';
    result := hf_chk(hf_q(s, 'LIMIT 10 OFFSET 200'), ref, 10, 'true', 200); RETURN NEXT;
    win := 'LIMIT 100';        result := hf_chk(hf_q(s, 'LIMIT 100'), ref, 100, 'true'); RETURN NEXT;
    win := 'LIMIT 300';        result := hf_chk(hf_q(s, 'LIMIT 300'), ref, 300, 'true'); RETURN NEXT;
    -- not an index key: the executor rejects 96 of every 97 ranked rows
    win := 'LIMIT 10, id % 97 = 0';
    result := hf_chk(hf_q(s, 'LIMIT 10', 'id % 97 = 0'), ref, 10, 'id % 97 = 0'); RETURN NEXT;
    IF s <> 'll' THEN
      -- every ranked row is rejected: the ladder runs to completion, then pads
      win := 'LIMIT 10, v IS NULL (padding only)';
      result := hf_chk(hf_q(s, 'LIMIT 10', 'v IS NULL'), ref, 10, 'false'); RETURN NEXT;
      -- 21 ranked rows (id % 997 = 1), then 9 padded ones
      win := 'LIMIT 30, id % 997 IN (0, 1) (ranked, then padded)';
      result := hf_chk(hf_q(s, 'LIMIT 30', 'id % 997 IN (0, 1)'), ref, 30, 'id % 997 IN (0, 1)'); RETURN NEXT;
    END IF;
  END LOOP;
END $$;
SET pg_weave.fuse_normalize = off;
SELECT * FROM hf_all();
