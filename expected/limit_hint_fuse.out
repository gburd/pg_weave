-- doc/GAPS.md G87, the fused route: the planner's LIMIT hint reaches a fused scan.
-- A fused plan has one ORDER BY key per channel plus the `<~>` weights transport;
-- weave_hint_indexscan() (src/am/customscan.c) writes LIMIT + OFFSET into the FIRST
-- lexical key's wquery `flags`, and weave_gettuple() (src/am/amscan.c) reads it from
-- the first lexical channel as the first fused pass width.  First pass only, never
-- wider than the unhinted one, so every answer is unchanged.
--
-- What each block guards, and the mutant that proves it can fail:
--   1. less fused work at LIMIT 10 on three shapes:
--        lexical first          (mutant: the old one-key-only rule)
--        vector first           (mutant: hint only the FIRST key)
--        two lexical channels   (mutants: no `break` in either loop -- the hint
--                                lands on one key and the scan reads another)
--      and never MORE at LIMIT 100            (mutant: no cap at the default)
--   2. exact answers, both pg_weave.fuse_normalize modes, every LIMIT/OFFSET window
--      below, a filter that pulls far past the hint, NULL vectors padded after
--      every ranked row (G71), generic plans, a cursor   (mutant: no widening)
--   3. EXPLAIN VERBOSE prints the query unchanged
--
-- The score oracle is weave_fuse_search() (unhinted: it builds its own scan keys),
-- and every check compares SCORE arrays, so equal scores in either order are right.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pg_weave;
ALTER EXTENSION pg_weave UPDATE;
RESET client_min_messages;
SET jit = off;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE hf (id int, d wdoc, v wvec(4)) WITH (autovacuum_enabled = off);
INSERT INTO hf SELECT g, to_wdoc('simple',
   CASE WHEN g % 10 < 3 THEN 'a ' ELSE '' END || CASE WHEN g % 10 >= 7 THEN 'b ' ELSE '' END ||
   CASE WHEN g % 10 = 5 THEN 'c ' ELSE '' END || repeat('x' || (g % 101) || ' ', 1 + g % 23)),
   CASE WHEN g % 997 = 0 THEN NULL
        ELSE ('[' || (g % 97) / 97.0 || ',' || (g % 89) / 89.0 || ',' ||
              (g % 83) / 83.0 || ',' || (g % 79) / 79.0 || ']')::wvec END
  FROM generate_series(1, 20000) g;
CREATE INDEX hf_w ON hf USING weave (d, v);
VACUUM ANALYZE hf;
SET enable_seqscan = off; SET enable_bitmapscan = off; SET enable_sort = off;
-- the three shapes; each must be a fused Index Scan with the transport key
CREATE FUNCTION hf_q(shape text, lim text, filt text DEFAULT 'true') RETURNS text
LANGUAGE sql IMMUTABLE AS $$
  SELECT format('SELECT ctid AS rowtid FROM hf WHERE %s ORDER BY fuse(%s) %s', filt,
    CASE shape
      WHEN 'lv' THEN $s$d <=> 'a | b | c'::wquery, v <-> '[0.3,0.6,0.2,0.9]'::wvec$s$
      WHEN 'vl' THEN $s$v <-> '[0.3,0.6,0.2,0.9]'::wvec, d <=> 'a | b | c'::wquery$s$
      WHEN 'll' THEN $s$d <=> 'a | b'::wquery, d <=> 'c'::wquery$s$ END, lim)
$$;
SELECT 'lv' AS shape; EXPLAIN (COSTS OFF) SELECT * FROM hf ORDER BY fuse(d <=> 'a | b | c'::wquery, v <-> '[0.3,0.6,0.2,0.9]'::wvec) LIMIT 10;
 shape 
-------
 lv
(1 row)

                                                            QUERY PLAN                                                             
-----------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using hf_w on hf
         Order By: ((d <=> '((''a'' | ''b'') | ''c'')'::wquery) AND (v <-> '[0.3,0.6,0.2,0.9]'::wvec) AND (d <~> '{1,1}'::real[]))
(3 rows)

SELECT 'vl' AS shape; EXPLAIN (COSTS OFF) SELECT * FROM hf ORDER BY fuse(v <-> '[0.3,0.6,0.2,0.9]'::wvec, d <=> 'a | b | c'::wquery) LIMIT 10;
 shape 
-------
