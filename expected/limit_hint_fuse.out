RESET pg_weave.fuse_normalize;
-- generic plans: a constant LIMIT is hinted at plan time; LIMIT $1 is a Param and
-- is not.  Both are executed several times from one cached generic plan.
SELECT hf_ref();
 hf_ref 
--------
 
(1 row)

SET plan_cache_mode = force_generic_plan;
PREPARE hf_c10 AS SELECT row_number() OVER () rn, rowtid
  FROM (SELECT ctid AS rowtid FROM hf WHERE id % 97 = 0
         ORDER BY fuse(d <=> 'a | b | c'::wquery, v <-> '[0.3,0.6,0.2,0.9]'::wvec) LIMIT 10) s;
PREPARE hf_p(int) AS SELECT row_number() OVER () rn, rowtid
  FROM (SELECT ctid AS rowtid FROM hf WHERE id % 97 = 0
         ORDER BY fuse(d <=> 'a | b | c'::wquery, v <-> '[0.3,0.6,0.2,0.9]'::wvec) LIMIT $1) s;
CREATE TEMP TABLE gp1 AS EXECUTE hf_c10;
CREATE TEMP TABLE gp2 AS EXECUTE hf_c10;
CREATE TEMP TABLE gp3 AS EXECUTE hf_p(25);
CREATE TEMP TABLE gp4 AS EXECUTE hf_p(25);
SELECT 'generic plan, constant LIMIT' AS shape,
       hf_chk('SELECT rowtid FROM gp1 ORDER BY rn', 'hr_lv', 10, 'id % 97 = 0') AS run1,
       hf_chk('SELECT rowtid FROM gp2 ORDER BY rn', 'hr_lv', 10, 'id % 97 = 0') AS run2;
            shape             |                    run1                     |                    run2                     
------------------------------+---------------------------------------------+---------------------------------------------
 generic plan, constant LIMIT | n=10 distinct=10 padded=0 tail_ok=t exact=t | n=10 distinct=10 padded=0 tail_ok=t exact=t
(1 row)

SELECT 'generic plan, LIMIT $1' AS shape,
       hf_chk('SELECT rowtid FROM gp3 ORDER BY rn', 'hr_lv', 25, 'id % 97 = 0') AS run1,
       hf_chk('SELECT rowtid FROM gp4 ORDER BY rn', 'hr_lv', 25, 'id % 97 = 0') AS run2;
         shape          |                    run1                     |                    run2                     
------------------------+---------------------------------------------+---------------------------------------------
 generic plan, LIMIT $1 | n=25 distinct=25 padded=0 tail_ok=t exact=t | n=25 distinct=25 padded=0 tail_ok=t exact=t
(1 row)

DEALLOCATE hf_c10; DEALLOCATE hf_p;
RESET plan_cache_mode;
-- a cursor reads the hinted plan a row at a time, past the hint
BEGIN;
DECLARE hf_cur CURSOR FOR SELECT ctid FROM hf WHERE id % 97 = 0
  ORDER BY fuse(d <=> 'a | b | c'::wquery, v <-> '[0.3,0.6,0.2,0.9]'::wvec) LIMIT 10;
CREATE TEMP TABLE cur_rows (rn serial, rowtid tid);
DO $$ DECLARE r record; c refcursor := 'hf_cur'; BEGIN
  LOOP FETCH c INTO r; EXIT WHEN NOT FOUND; INSERT INTO cur_rows (rowtid) VALUES (r.ctid); END LOOP; END $$;
COMMIT;
SELECT 'cursor, filtered past the hint' AS shape,
       hf_chk('SELECT rowtid FROM cur_rows ORDER BY rn', 'hr_lv', 10, 'id % 97 = 0');
             shape              |                   hf_chk                    
--------------------------------+---------------------------------------------
 cursor, filtered past the hint | n=10 distinct=10 padded=0 tail_ok=t exact=t
(1 row)

-- 3.  Invisible in EXPLAIN.
EXPLAIN (VERBOSE, COSTS OFF)
  SELECT id FROM hf ORDER BY fuse(d <=> 'a | b | c'::wquery, v <-> '[0.3,0.6,0.2,0.9]'::wvec) LIMIT 10;
                                                                                                                                               QUERY PLAN                                                                                                                                               
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: id, (COALESCE(weave_current_fused_distance('hf_w'::regclass, ctid, '((''a'' | ''b'') | ''c'')'::wquery, '[0.3,0.6,0.2,0.9]'::wvec, '{1,1}'::real[]), fuse(weave_lexscore((d <=> '((''a'' | ''b'') | ''c'')'::wquery)), weave_l2score((v <-> '[0.3,0.6,0.2,0.9]'::wvec)), NULL::real[])))
   ->  Index Scan using hf_w on public.hf
         Output: id, COALESCE(weave_current_fused_distance('hf_w'::regclass, ctid, '((''a'' | ''b'') | ''c'')'::wquery, '[0.3,0.6,0.2,0.9]'::wvec, '{1,1}'::real[]), fuse(weave_lexscore((d <=> '((''a'' | ''b'') | ''c'')'::wquery)), weave_l2score((v <-> '[0.3,0.6,0.2,0.9]'::wvec)), NULL::real[]))
         Order By: ((hf.d <=> '((''a'' | ''b'') | ''c'')'::wquery) AND (hf.v <-> '[0.3,0.6,0.2,0.9]'::wvec) AND (hf.d <~> '{1,1}'::real[]))
(5 rows)

RESET enable_seqscan; RESET enable_bitmapscan; RESET enable_sort;
DROP TABLE hf;
DROP FUNCTION hf_q(text, text, text);
DROP FUNCTION hf_work(text, int, text);
DROP FUNCTION hf_ref();
DROP FUNCTION hf_chk(text, text, int, text, int);
DROP FUNCTION hf_all();
