(1 row)

                                                            QUERY PLAN                                                             
-----------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using hf_w on hf
         Order By: ((v <-> '[0.3,0.6,0.2,0.9]'::wvec) AND (d <=> '((''a'' | ''b'') | ''c'')'::wquery) AND (d <~> '{1,1}'::real[]))
(3 rows)

SELECT 'll' AS shape; EXPLAIN (COSTS OFF) SELECT * FROM hf ORDER BY fuse(d <=> 'a | b'::wquery, d <=> 'c'::wquery) LIMIT 10;
 shape 
-------
