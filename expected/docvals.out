RESET enable_seqscan;
RESET enable_bitmapscan;
DELETE FROM dvs_cases;
INSERT INTO dvs_cases
SELECT 'dvtm', 'cat', o.op, k.k
  FROM (VALUES ('<'), ('<='), ('='), ('>='), ('>')) o(op),
       (VALUES ('k0003'), ('k0020'), ('k0000'), ('k0024'), ('c10'), (''),
               ('c105'), ('k00035'), (' '), ('zzz')) k(k);
CREATE TEMP TABLE dvs_res AS
SELECT tbl, col, op, k, dvs_agree(tbl, format('%I %s %L', col, op, k)) AS ok
  FROM dvs_cases;
SELECT count(*) AS ncases, bool_and(ok) AS collapsed_all_agree FROM dvs_res;
