-- the TEXT domain: a two-key range on a text_docval_ops column
CREATE TABLE dvkt (id int, body wdoc, cat text COLLATE "C");
INSERT INTO dvkt
SELECT g, to_wdoc('common w' || (g % 7)),
       CASE WHEN g % 19 = 0 THEN NULL
            ELSE 'c' || lpad((g % 40)::text, 2, '0') END
FROM generate_series(1, 2000) g;
CREATE INDEX dvkt_w ON dvkt USING weave (body wdoc_lex_ops, cat text_docval_ops);
ANALYZE dvkt;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF) SELECT id FROM dvkt WHERE cat >= 'c10' AND cat < 'c20';
                          QUERY PLAN                          
--------------------------------------------------------------
 Index Scan using dvkt_w on dvkt
   Index Cond: ((cat >= 'c10'::text) AND (cat < 'c20'::text))
(2 rows)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT dvs_agree('dvkt', $$cat >= 'c10' AND cat < 'c20'$$)  AS text_range_agrees,
       dvs_agree('dvkt', $$cat > 'c20' AND cat < 'c10'$$)   AS text_empty_agrees,
       dvs_agree('dvkt', $$cat >= 'c10' AND cat <= 'c10'$$) AS text_point_agrees;
