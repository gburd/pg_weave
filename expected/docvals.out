-- A FUSED query narrowed by a text docvalues qual (the section (4) pattern):
-- the qual is borrowed as the fused scan's gate (Index Cond, not Filter), every
-- returned row satisfies it, and the narrowed answer is a subset of the
-- unnarrowed one.
CREATE TABLE dvf (id int, body wdoc, emb wvec(4), cat text COLLATE "C");
INSERT INTO dvf
SELECT g,
       to_wdoc('common doc ' || (g % 5)),
       ('[' || g || ',' || (g % 4) || ',' || (g % 7) || ',1]')::wvec,
       'c' || lpad((g % 40)::text, 2, '0')
FROM generate_series(1, 500) g;
CREATE INDEX dvf_w ON dvf USING weave (body, emb, cat text_docval_ops)
    WITH (metric = ip);
ANALYZE dvf;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT id FROM dvf
 WHERE cat < 'c08'
 ORDER BY fuse(body <=> 'common'::wquery, emb <#> '[1,1,1,1]'::wvec) LIMIT 10;
                                                     QUERY PLAN                                                     
--------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using dvf_w on dvf
         Index Cond: (cat < 'c08'::text)
         Order By: ((body <=> '''common'''::wquery) AND (emb <#> '[1,1,1,1]'::wvec) AND (body <~> '{1,1}'::real[]))
(4 rows)

CREATE TEMP TABLE dvf_gated AS
SELECT id FROM dvf
 WHERE cat < 'c08'
 ORDER BY fuse(body <=> 'common'::wquery, emb <#> '[1,1,1,1]'::wvec) LIMIT 10;
CREATE TEMP TABLE dvf_ungated AS
SELECT id FROM dvf
 ORDER BY fuse(body <=> 'common'::wquery, emb <#> '[1,1,1,1]'::wvec) LIMIT 500;
RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT count(*) AS gated_rows FROM dvf_gated;
 gated_rows 
------------
         10
(1 row)

SELECT count(*) AS gated_rows_failing_qual
  FROM dvf_gated JOIN dvf USING (id)
 WHERE NOT (dvf.cat < 'c08');
 gated_rows_failing_qual 
-------------------------
                       0
(1 row)

SELECT NOT EXISTS (SELECT 1 FROM dvf_gated
                    WHERE id NOT IN (SELECT id FROM dvf_ungated))
       AS gated_is_subset_of_ungated;
 gated_is_subset_of_ungated 
----------------------------
 t
(1 row)

