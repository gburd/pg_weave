RESET enable_seqscan;
RESET enable_bitmapscan;
CREATE TEMP TABLE dvs_cases (tbl text, col text, op text, k text);
INSERT INTO dvs_cases
SELECT 'dvs', c.col, o.op, k.k
  FROM (VALUES ('cat'), ('cat2')) c(col),
       (VALUES ('<'), ('<='), ('='), ('>='), ('>')) o(op),
       (VALUES ('c10'), (''), ('c105'), (' '), ('zzz')) k(k);
-- cat2's own present / case-variant / between values
INSERT INTO dvs_cases
SELECT 'dvs', 'cat2', o.op, k.k
  FROM (VALUES ('<'), ('<='), ('='), ('>='), ('>')) o(op),
       (VALUES ('apple'), ('Apple'), ('B'), ('b'), ('Apricot'), ('a b'),
               ('10'), ('Zeta')) k(k);
-- varchar: one strategy suffices for the coercion path, plus equality
INSERT INTO dvs_cases VALUES
  ('dvs', 'cv', '<', 'v15'), ('dvs', 'cv', '=', 'v15'),
  ('dvs', 'cv', '>', 'v155'), ('dvs', 'cv', '<', '');
CREATE TEMP TABLE dvs_res AS
SELECT tbl, col, op, k, dvs_agree(tbl, format('%I %s %L', col, op, k)) AS ok
  FROM dvs_cases;
SELECT col, count(*) AS ncases, bool_and(ok) AS all_agree
  FROM dvs_res GROUP BY col ORDER BY col;
 col  | ncases | all_agree 
------+--------+-----------
 cat  |     25 | t
 cat2 |     65 | t
 cv   |      4 | t
(3 rows)

