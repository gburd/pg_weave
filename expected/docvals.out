DROP TABLE dvs;
-- THE MULTI-SEGMENT COLLAPSE, SEMANTICALLY (10b showed the weft is there; this
-- shows it is RIGHT).  The same corpus as 10b, so seven flushed bolts with
-- DIFFERENT dictionaries ('k' || g/500 is disjoint per heap range) are
-- re-dictionaried by the collapse.  A merge that concatenated ordinals instead
-- would map 'k0003' and 'k0020' to other bolts' strings, and these would
-- disagree with the heap.
CREATE TABLE dvtm (id int, body wdoc, cat text COLLATE "C");
INSERT INTO dvtm
SELECT g, to_wdoc(array_to_string(ARRAY(SELECT 'id' || g || 'x' || k
                                          FROM generate_series(1, 40) k), ' ')),
       CASE WHEN g % 19 = 0 THEN NULL
            WHEN g % 40 = 0 THEN ''
            WHEN g % 3 = 0 THEN 'c' || lpad((g % 40)::text, 2, '0')
            ELSE 'k' || lpad((g / 500)::text, 4, '0') END
FROM generate_series(1, 12000) g;
SET maintenance_work_mem = '1MB';
SET max_parallel_maintenance_workers = 0;
CREATE INDEX dvtm_idx ON dvtm USING weave (body wdoc_lex_ops, cat text_docval_ops);
RESET maintenance_work_mem;
RESET max_parallel_maintenance_workers;
ANALYZE dvtm;
SELECT weave_index_nsegments('dvtm_idx') = 1 AS collapsed_to_one_segment;
 collapsed_to_one_segment 
--------------------------
 t
(1 row)

SET enable_seqscan = off;
SET enable_bitmapscan = off;
