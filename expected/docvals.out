-- a clause whose collation differs from the column's is NOT an index clause
-- (the planner's IndexCollMatchesExprColl); it stays a Filter and agrees
SELECT dvs_agree('dvs', $$cat2 < 'apple' COLLATE "C"$$) AS other_collation_agrees;
 other_collation_agrees 
------------------------
