-- ---------------------------------------------------------------------------
-- 12. a docvalues key on an ORDERING scan the gate does not feed
-- (doc/GAPS.md G55).  `WHERE price < c ORDER BY body <=> q` plans as ONE Index
-- Scan with the price key in the Index Cond, but the BM25 ranking pass never
-- consults the docvalues gate; the executor re-evaluates an Index Cond only
-- when the AM asks (xs_recheck), and before the fix this returned every row
-- the ranking reached -- 2400 of 3000 violating the predicate.  The answer is
-- the same SET as the heap's, and no returned row violates the predicate.
-- ---------------------------------------------------------------------------
CREATE TABLE dvo (id int, body wdoc, price int8, cat text COLLATE "C");
INSERT INTO dvo
SELECT g, to_wdoc('common w' || (g % 7)), g % 100, 'c' || lpad((g % 40)::text, 2, '0')
FROM generate_series(1, 3000) g;
CREATE INDEX dvo_p ON dvo USING weave (body wdoc_lex_ops, price int8_docval_ops);
ANALYZE dvo;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT id FROM dvo WHERE price < 20 ORDER BY body <=> 'common'::wquery LIMIT 5000;
                    QUERY PLAN                     
---------------------------------------------------
 Limit
   ->  Index Scan using dvo_p on dvo
         Index Cond: (price < 20)
         Order By: (body <=> '''common'''::wquery)
(4 rows)

CREATE TEMP TABLE dvo_r AS
SELECT id, price FROM dvo WHERE price < 20 ORDER BY body <=> 'common'::wquery LIMIT 5000;
RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT count(*) AS ordered_rows,
       count(*) FILTER (WHERE price >= 20) AS ordered_rows_violating,
       (SELECT count(*) FROM dvo WHERE price < 20) AS heap_rows
  FROM dvo_r;
 ordered_rows | ordered_rows_violating | heap_rows 
--------------+------------------------+-----------
          600 |                      0 |       600
(1 row)

DROP TABLE dvo_r;
DROP INDEX dvo_p;
-- the same on a text facet
CREATE INDEX dvo_c ON dvo USING weave (body wdoc_lex_ops, cat text_docval_ops);
SET enable_seqscan = off;
SET enable_bitmapscan = off;
CREATE TEMP TABLE dvo_r AS
SELECT id, cat FROM dvo WHERE cat < 'c05' ORDER BY body <=> 'common'::wquery LIMIT 5000;
RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT count(*) AS ordered_rows,
       count(*) FILTER (WHERE cat >= 'c05') AS ordered_rows_violating,
       (SELECT count(*) FROM dvo WHERE cat < 'c05') AS heap_rows
  FROM dvo_r;
 ordered_rows | ordered_rows_violating | heap_rows 
--------------+------------------------+-----------
          375 |                      0 |       375
(1 row)

DROP TABLE dvo_r;
DROP TABLE dvo;
-- ---------------------------------------------------------------------------
-- 13. keys the scan does not honour are rechecked (doc/GAPS.md G56) and
-- deleted docvalues do not leak (G57).
--
-- G56: an Index Scan re-evaluates an Index Cond only when the AM asks
-- (xs_recheck).  Two shapes were dropped with no recheck: a restriction `@@@`
-- beside a DIFFERENT `<=>` query (the ORDER BY dispatch overwrote the
-- restriction query -- measured 1000 rows returned, every one violating), and
-- a SECOND `@@@` key (it reached only a flag the lexical routes never read --
-- measured 1000 rows for a 1-row answer).  Each answer below is compared with
-- the heap's, and the violating count must be zero.  An `<=>` ordering scan
-- emits only rows its ORDER BY query ranks, so `@@@ 'alpha' ORDER BY <=> 'beta'`
-- (no row holds both) is correct at zero rows, and the ORDER BY 'common' form
-- is the one whose count is the heap's.
--
-- G57: a bolt's docvalues store keeps a deleted row's value; after VACUUM frees
-- the slot and an INSERT reuses the TID, the stale value was reported for the
-- new tuple (measured: `price < 50` 932 rows via the index, 500 on the heap).
-- The nested-loop rescans at the end also exercise the G59 frees: every outer
-- row rescans the inner index scan, which releases the previous match set.
-- Alpha rows are the even ids.
-- ---------------------------------------------------------------------------
CREATE TABLE pr (id int, body wdoc, price int8);
INSERT INTO pr
SELECT g,
       to_wdoc(CASE WHEN g % 2 = 0 THEN 'alpha' ELSE 'beta' END || ' common w' || g),
       g % 100
FROM generate_series(1, 2000) g;
CREATE INDEX pr_w ON pr USING weave (body wdoc_lex_ops, price int8_docval_ops);
ANALYZE pr;
-- G56a: a restriction `@@@` beside an ordering `<=>` over another query.
-- other_query_rows used to be 0 against heap_rows 1000: no 'alpha' row
-- matches 'beta', and the ordering scan emitted only rows its ORDER BY query
-- ranks.  Since the G56 padding phase it emits the rest of the table after the
-- ranked rows, so the answer equals the heap's.
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT id FROM pr WHERE body @@@ 'alpha'::wquery
ORDER BY body <=> 'beta'::wquery LIMIT 5000;
                     QUERY PLAN                     
----------------------------------------------------
 Limit
   ->  Index Scan using pr_w on pr
         Index Cond: (body @@@ '''alpha'''::wquery)
         Order By: (body <=> '''beta'''::wquery)
(4 rows)

CREATE TEMP TABLE pr_r AS
SELECT id FROM pr WHERE body @@@ 'alpha'::wquery
ORDER BY body <=> 'beta'::wquery LIMIT 5000;
CREATE TEMP TABLE pr_c AS
SELECT id FROM pr WHERE body @@@ 'alpha'::wquery
ORDER BY body <=> 'common'::wquery LIMIT 5000;
-- the flagship shape (the same query on both sides) keeps its answer
CREATE TEMP TABLE pr_s AS
SELECT id FROM pr WHERE body @@@ 'alpha'::wquery
ORDER BY body <=> 'alpha'::wquery LIMIT 5000;
RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT (SELECT count(*) FROM pr_r) AS other_query_rows,
       (SELECT count(*) FROM pr_r WHERE id % 2 = 1) AS other_query_violating,
       (SELECT count(*) FROM pr_c) AS common_rows,
       (SELECT count(*) FROM pr_c WHERE id % 2 = 1) AS common_violating,
       (SELECT count(*) FROM pr_s) AS same_query_rows,
       (SELECT count(*) FROM pr_s WHERE id % 2 = 1) AS same_query_violating,
       (SELECT count(*) FROM pr WHERE id % 2 = 0) AS heap_rows;
 other_query_rows | other_query_violating | common_rows | common_violating | same_query_rows | same_query_violating | heap_rows 
------------------+-----------------------+-------------+------------------+-----------------+----------------------+-----------
             1000 |                     0 |        1000 |                0 |            1000 |                    0 |      1000
(1 row)

DROP TABLE pr_r, pr_c, pr_s;
-- G56b: two `@@@` keys on one scan -- plain Index Scan, then bitmap
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM pr WHERE body @@@ 'alpha'::wquery AND body @@@ 'w10'::wquery;
                                      QUERY PLAN                                       
---------------------------------------------------------------------------------------
 Aggregate
   ->  Index Scan using pr_w on pr
         Index Cond: ((body @@@ '''alpha'''::wquery) AND (body @@@ '''w10'''::wquery))
(3 rows)

SELECT count(*) AS two_keys_index
  FROM pr WHERE body @@@ 'alpha'::wquery AND body @@@ 'w10'::wquery;
 two_keys_index 
----------------
              1
(1 row)

SELECT count(*) AS two_keys_and_price_index
  FROM pr WHERE body @@@ 'alpha'::wquery AND body @@@ 'w10'::wquery AND price < 50;
 two_keys_and_price_index 
--------------------------
                        1
(1 row)

SET enable_indexscan = off;
RESET enable_bitmapscan;
SELECT count(*) AS two_keys_bitmap
  FROM pr WHERE body @@@ 'alpha'::wquery AND body @@@ 'w10'::wquery;
 two_keys_bitmap 
-----------------
               1
(1 row)

RESET enable_seqscan;
SET enable_bitmapscan = off;
SELECT count(*) AS two_keys_heap
  FROM pr WHERE body @@@ 'alpha'::wquery AND body @@@ 'w10'::wquery;
 two_keys_heap 
---------------
             1
(1 row)

RESET enable_indexscan;
RESET enable_bitmapscan;
-- G57: delete half, VACUUM (tombstones the docids, frees the heap slots), and
-- re-insert into the freed slots with a value no predicate below admits
DELETE FROM pr WHERE id <= 1000;
DO $$ BEGIN PERFORM pg_temp.wait_for_horizon(); END $$;   -- G60
VACUUM pr;
INSERT INTO pr
SELECT g,
       to_wdoc(CASE WHEN g % 2 = 0 THEN 'alpha' ELSE 'beta' END || ' common w' || g),
       999
FROM generate_series(2001, 3000) g;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM pr WHERE price < 50::int8;
                 QUERY PLAN                 
--------------------------------------------
 Aggregate
   ->  Index Scan using pr_w on pr
         Index Cond: (price < '50'::bigint)
(3 rows)

SELECT count(*) AS after_reuse_index FROM pr WHERE price < 50::int8;
 after_reuse_index 
-------------------
               500
(1 row)

SELECT count(*) AS after_reuse_lex_index
  FROM pr WHERE body @@@ 'common'::wquery AND price < 50::int8;
 after_reuse_lex_index 
-----------------------
                   500
(1 row)

SET enable_indexscan = off;
RESET enable_bitmapscan;
SELECT count(*) AS after_reuse_bitmap FROM pr WHERE price < 50::int8;
 after_reuse_bitmap 
--------------------
                500
(1 row)

RESET enable_seqscan;
SET enable_bitmapscan = off;
SELECT count(*) AS after_reuse_heap FROM pr WHERE price < 50::int8;
 after_reuse_heap 
------------------
              500
(1 row)

SELECT count(*) AS after_reuse_lex_heap
  FROM pr WHERE body @@@ 'common'::wquery AND price < 50::int8;
 after_reuse_lex_heap 
----------------------
                  500
(1 row)

RESET enable_indexscan;
RESET enable_bitmapscan;
-- nested-loop rescans with a docvalues key, alone and ANDed with `@@@`: the
-- inner scan is rescanned once per k, and every k must agree with the heap
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT k, c.n FROM generate_series(1, 20) k,
       LATERAL (SELECT count(*) AS n FROM pr WHERE price < k) c;
                QUERY PLAN                
------------------------------------------
 Nested Loop
   ->  Function Scan on generate_series k
   ->  Aggregate
         ->  Index Scan using pr_w on pr
               Index Cond: (price < k.k)
(5 rows)

CREATE TEMP TABLE pr_ni AS
SELECT k, c.n, c2.n AS n2 FROM generate_series(1, 20) k,
       LATERAL (SELECT count(*) AS n FROM pr WHERE price < k) c,
       LATERAL (SELECT count(*) AS n FROM pr
                 WHERE body @@@ 'alpha'::wquery AND price < k) c2;
SET enable_indexscan = off;
RESET enable_bitmapscan;
CREATE TEMP TABLE pr_nb AS
SELECT k, c.n, c2.n AS n2 FROM generate_series(1, 20) k,
       LATERAL (SELECT count(*) AS n FROM pr WHERE price < k) c,
       LATERAL (SELECT count(*) AS n FROM pr
                 WHERE body @@@ 'alpha'::wquery AND price < k) c2;
RESET enable_seqscan;
SET enable_bitmapscan = off;
CREATE TEMP TABLE pr_nh AS
SELECT k, c.n, c2.n AS n2 FROM generate_series(1, 20) k,
       LATERAL (SELECT count(*) AS n FROM pr WHERE price < k) c,
       LATERAL (SELECT count(*) AS n FROM pr
                 WHERE body @@@ 'alpha'::wquery AND price < k) c2;
RESET enable_indexscan;
RESET enable_bitmapscan;
SELECT (SELECT count(*) FROM pr_nh) AS outer_rows,
       (SELECT count(*) FROM (SELECT * FROM pr_ni EXCEPT SELECT * FROM pr_nh) d)
           AS index_disagreements,
       (SELECT count(*) FROM (SELECT * FROM pr_nb EXCEPT SELECT * FROM pr_nh) d)
           AS bitmap_disagreements,
       (SELECT sum(n) FROM pr_nh) AS heap_total;
 outer_rows | index_disagreements | bitmap_disagreements | heap_total 
------------+---------------------+----------------------+------------
         20 |                   0 |                    0 |       2100
(1 row)

DROP TABLE pr_ni, pr_nb, pr_nh;
DROP TABLE pr;
-- a cgram `@~` key beside an ordering `<=>`: no ranking pass consults the
-- pattern, so it is rechecked (G56).  sql/cgram.sql's index shape.
CREATE TABLE prg (id int, d wdoc, body text);
INSERT INTO prg
SELECT g, to_wdoc('simple', b), b
FROM (SELECT g, CASE WHEN g % 2 = 0 THEN 'alpha' ELSE 'beta' END
                || ' common w' || g AS b
        FROM generate_series(1, 2000) g) s;
CREATE INDEX prg_idx ON prg USING weave (d, body gram_ops);
ANALYZE prg;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT id FROM prg WHERE body @~ '%alpha%'
ORDER BY d <=> 'common'::wquery LIMIT 5000;
                   QUERY PLAN                   
------------------------------------------------
 Limit
   ->  Index Scan using prg_idx on prg
         Index Cond: (body @~ '%alpha%'::text)
         Order By: (d <=> '''common'''::wquery)
(4 rows)

CREATE TEMP TABLE prg_r AS
SELECT id FROM prg WHERE body @~ '%alpha%'
ORDER BY d <=> 'common'::wquery LIMIT 5000;
RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT count(*) AS cgram_ordered_rows,
       count(*) FILTER (WHERE id % 2 = 1) AS cgram_ordered_violating,
       (SELECT count(*) FROM prg WHERE body LIKE '%alpha%') AS heap_rows
  FROM prg_r;
 cgram_ordered_rows | cgram_ordered_violating | heap_rows 
--------------------+-------------------------+-----------
               1000 |                       0 |      1000
(1 row)

DROP TABLE prg_r;
DROP TABLE prg;
-- ---------------------------------------------------------------------------
-- 14. the remaining routes a restriction key reaches (review of G55/G56):
-- a docvalues key beside a VECTOR `<#>` ordering and an EDIT-DISTANCE `<@>`
-- ordering (the recheck chain's final arm), a TEXT docvalues key on the bitmap
-- route, two `@@@` keys under a fused ORDER BY, and two `@~` keys.  Each is
-- compared with the heap: index rows outside the heap answer must be zero,
-- and where the ordering ranks every row the counts must match too.
-- ---------------------------------------------------------------------------
CREATE TABLE rk (id int, body wdoc, emb wvec(4), price int8, cat text, raw text);
INSERT INTO rk
SELECT g,
       to_wdoc('simple', CASE WHEN g % 2 = 0 THEN 'alpha' ELSE 'beta' END
                         || ' common w' || g),
       ('[' || (g % 13) || ',' || (g % 7) || ',' || (g % 5) || ',1]')::wvec,
       g % 100,
       'c' || lpad((g % 40)::text, 2, '0'),
       CASE WHEN g % 2 = 0 THEN 'alpha' ELSE 'beta' END || ' common w' || g
FROM generate_series(1, 2000) g;
-- one docvalues column per index in this version, and one weave index per
-- table keeps the plan unambiguous: the text key and the cgram keys get their
-- own copies of the same rows
CREATE TABLE rkt AS SELECT id, body, cat FROM rk;
CREATE TABLE rkg AS SELECT id, body, raw FROM rk;
CREATE INDEX rk_w ON rk USING weave (body wdoc_lex_ops, emb, price int8_docval_ops)
    WITH (metric = ip);
CREATE INDEX rkt_w ON rkt USING weave (body wdoc_lex_ops, cat text_docval_ops);
CREATE INDEX rkg_w ON rkg USING weave (body, raw gram_ops);
ANALYZE rk;
ANALYZE rkt;
ANALYZE rkg;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
-- vector `<#>` ranks every row, so the answer is exactly the heap's
EXPLAIN (COSTS OFF)
SELECT id FROM rk WHERE price < 20 ORDER BY emb <#> '[1,1,1,1]'::wvec LIMIT 5000;
                  QUERY PLAN                   
-----------------------------------------------
 Limit
   ->  Index Scan using rk_w on rk
         Index Cond: (price < 20)
         Order By: (emb <#> '[1,1,1,1]'::wvec)
(4 rows)

CREATE TEMP TABLE rk_vec AS
SELECT id FROM rk WHERE price < 20 ORDER BY emb <#> '[1,1,1,1]'::wvec LIMIT 5000;
-- edit-distance `<@>` beside a docvalues key
EXPLAIN (COSTS OFF)
SELECT id FROM rk WHERE price < 20 ORDER BY body <@> 'commn' LIMIT 5000;
                 QUERY PLAN                 
--------------------------------------------
 Limit
   ->  Index Scan using rk_w on rk
         Index Cond: (price < 20)
         Order By: (body <@> 'commn'::text)
(4 rows)

CREATE TEMP TABLE rk_ed AS
SELECT id FROM rk WHERE price < 20 ORDER BY body <@> 'commn' LIMIT 5000;
-- two `@@@` keys under a fused ORDER BY (fusepath borrows the second)
EXPLAIN (COSTS OFF)
SELECT id FROM rk WHERE body @@@ 'alpha'::wquery AND body @@@ 'w10'::wquery
 ORDER BY fuse(body <=> 'common'::wquery, emb <#> '[1,1,1,1]'::wvec) LIMIT 5000;
                                                     QUERY PLAN                                                     
--------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using rk_w on rk
         Index Cond: ((body @@@ '''alpha'''::wquery) AND (body @@@ '''w10'''::wquery))
         Order By: ((body <=> '''common'''::wquery) AND (emb <#> '[1,1,1,1]'::wvec) AND (body <~> '{1,1}'::real[]))
(4 rows)

CREATE TEMP TABLE rk_fu AS
SELECT id FROM rk WHERE body @@@ 'alpha'::wquery AND body @@@ 'w10'::wquery
 ORDER BY fuse(body <=> 'common'::wquery, emb <#> '[1,1,1,1]'::wvec) LIMIT 5000;
-- two `@~` keys, plain Index Scan
EXPLAIN (COSTS OFF)
SELECT count(*) FROM rkg WHERE raw @~ '%alpha%' AND raw @~ '%w10%';
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Aggregate
   ->  Index Scan using rkg_w on rkg
         Index Cond: ((raw @~ '%alpha%'::text) AND (raw @~ '%w10%'::text))
(3 rows)

CREATE TEMP TABLE rk_cg AS
SELECT id FROM rkg WHERE raw @~ '%alpha%' AND raw @~ '%w10%';
-- TEXT docvalues key on the bitmap route, alone and beside `@@@`
SET enable_indexscan = off;
RESET enable_bitmapscan;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM rkt WHERE body @@@ 'alpha'::wquery AND cat < 'c10';
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on rkt
         Recheck Cond: ((body @@@ '''alpha'''::wquery) AND (cat < 'c10'::text))
         ->  Bitmap Index Scan on rkt_w
               Index Cond: ((body @@@ '''alpha'''::wquery) AND (cat < 'c10'::text))
(5 rows)

CREATE TEMP TABLE rk_bt AS
SELECT id FROM rkt WHERE body @@@ 'alpha'::wquery AND cat < 'c10';
CREATE TEMP TABLE rk_bt2 AS
SELECT id FROM rkt WHERE cat >= 'c10' AND cat <= 'c12';
RESET enable_indexscan;
RESET enable_seqscan;
SET enable_indexscan = off;
SET enable_bitmapscan = off;
CREATE TEMP TABLE rk_h AS
SELECT id,
       price < 20 AS p20,
       body @@@ 'alpha'::wquery AND body @@@ 'w10'::wquery AS two_lex,
       raw LIKE '%alpha%' AND raw LIKE '%w10%' AS two_gram,
       body @@@ 'alpha'::wquery AND cat < 'c10' AS lex_text,
       cat >= 'c10' AND cat <= 'c12' AS text_range
  FROM rk;
RESET enable_indexscan;
RESET enable_bitmapscan;
SELECT (SELECT count(*) FROM rk_vec) AS vec_rows,
       (SELECT count(*) FROM rk_vec JOIN rk_h USING (id) WHERE NOT p20) AS vec_violating,
       (SELECT count(*) FROM rk_ed JOIN rk_h USING (id) WHERE NOT p20) AS ed_violating,
       (SELECT count(*) FROM rk_ed) <= (SELECT count(*) FROM rk_h WHERE p20) AS ed_within,
       (SELECT count(*) FROM rk_fu) AS fu_rows,
       (SELECT count(*) FROM rk_fu JOIN rk_h USING (id) WHERE NOT two_lex) AS fu_violating,
       (SELECT count(*) FROM rk_cg) AS cg_rows,
       (SELECT count(*) FROM rk_cg JOIN rk_h USING (id) WHERE NOT two_gram) AS cg_violating,
       (SELECT count(*) FROM rk_bt) AS bt_rows,
       (SELECT count(*) FROM rk_bt JOIN rk_h USING (id) WHERE NOT lex_text) AS bt_violating,
       (SELECT count(*) FROM rk_bt2) AS bt2_rows,
       (SELECT count(*) FROM rk_bt2 JOIN rk_h USING (id) WHERE NOT text_range) AS bt2_violating;
 vec_rows | vec_violating | ed_violating | ed_within | fu_rows | fu_violating | cg_rows | cg_violating | bt_rows | bt_violating | bt2_rows | bt2_violating 
