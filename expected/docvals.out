-- ---------------------------------------------------------------------------
-- 11. several docvalues keys on one scan AND (doc/GAPS.md G54).  A range
-- `price > 10 AND price < 20` is TWO Index Cond keys on the one docvalues
-- column.  weave_rescan() used to capture only the first and drop the second
-- with no recheck, so the scan returned every row above 10 (2670 here instead
-- of 270).  Every route that reaches weave_docvals_gate() is covered: the plain
-- Index Scan (dvs_agree), the bitmap scan (getbitmap), and the fused pass; and
-- both key domains, int8 and text.  Each agreement is index == heap as a SET.
-- ---------------------------------------------------------------------------
CREATE TABLE dvk (id int, body wdoc, emb wvec(4), price bigint);
-- price = g % 100 over 3000 rows: each value 0..99 appears 30 times
INSERT INTO dvk
SELECT g,
       to_wdoc('common w' || (g % 7)),
       ('[' || g || ',' || (g % 4) || ',' || (g % 7) || ',1]')::wvec,
       (g % 100)::bigint
FROM generate_series(1, 3000) g;
CREATE INDEX dvk_w ON dvk USING weave (body, emb, price int8_docval_ops)
    WITH (metric = ip);
ANALYZE dvk;
-- plan shape: BOTH keys are in the Index Cond (neither is a Filter)
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM dvk WHERE price > 10::int8 AND price < 20::int8;
                               QUERY PLAN                                
-------------------------------------------------------------------------
 Aggregate
   ->  Index Scan using dvk_w on dvk
         Index Cond: ((price > '10'::bigint) AND (price < '20'::bigint))
(3 rows)

-- the reported case, through the index: 9 values x 30 rows
SELECT count(*) AS range_10_20 FROM dvk WHERE price > 10::int8 AND price < 20::int8;
 range_10_20 
-------------
         270
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT dvs_agree('dvk', 'price > 10 AND price < 20')      AS open_range_agrees,
       dvs_agree('dvk', 'price >= 10 AND price <= 10')    AS closed_point_agrees,
       dvs_agree('dvk', 'price > 50 AND price < 40')      AS empty_range_agrees,
       dvs_agree('dvk', 'price = 5 AND price = 6')        AS two_eq_agrees,
       dvs_agree('dvk', 'price >= 0 AND price < 100 AND price > 98')
                                                          AS three_keys_agree,
       dvs_agree('dvk', $$body @@@ 'common'::wquery AND price > 10 AND price < 20$$)
                                                          AS lex_and_range_agrees;
 open_range_agrees | closed_point_agrees | empty_range_agrees | two_eq_agrees | three_keys_agree | lex_and_range_agrees 
-------------------+---------------------+--------------------+---------------+------------------+----------------------
 t                 | t                   | t                  | t             | t                | t
(1 row)

-- a NULL runtime key in the conjunction empties all of it
SET plan_cache_mode = force_generic_plan;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
PREPARE dvk_null(bigint) AS
    SELECT count(*) FROM dvk WHERE price > $1 AND price < 20;
EXECUTE dvk_null(NULL);
 count 
-------
     0
(1 row)

EXECUTE dvk_null(10);
 count 
-------
   270
(1 row)

DEALLOCATE dvk_null;
RESET enable_seqscan;
RESET enable_bitmapscan;
RESET plan_cache_mode;
-- the BITMAP route (weave_getbitmap): a docvalues-only bitmap goes out
-- non-lossy, so the executor does not recheck and a dropped key would show
SET enable_seqscan = off;
SET enable_indexscan = off;
SET enable_bitmapscan = on;
EXPLAIN (COSTS OFF) SELECT id FROM dvk WHERE price > 10 AND price < 20;
                     QUERY PLAN                      
-----------------------------------------------------
 Bitmap Heap Scan on dvk
   Recheck Cond: ((price > 10) AND (price < 20))
   ->  Bitmap Index Scan on dvk_w
         Index Cond: ((price > 10) AND (price < 20))
(4 rows)

CREATE TEMP TABLE dvk_bm AS SELECT id FROM dvk WHERE price > 10 AND price < 20;
RESET enable_seqscan;
RESET enable_indexscan;
RESET enable_bitmapscan;
SET enable_indexscan = off;
SET enable_bitmapscan = off;
CREATE TEMP TABLE dvk_heap AS SELECT id FROM dvk WHERE price > 10 AND price < 20;
RESET enable_indexscan;
RESET enable_bitmapscan;
SELECT (SELECT count(*) FROM dvk_bm) AS bitmap_rows,
       NOT EXISTS (SELECT id FROM dvk_bm EXCEPT SELECT id FROM dvk_heap
                   UNION ALL
                   SELECT id FROM dvk_heap EXCEPT SELECT id FROM dvk_bm)
       AS bitmap_agrees;
