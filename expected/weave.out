CREATE EXTENSION pg_weave VERSION '0.1.0';
-- wdoc: analysis, output shows terms with term frequencies
SELECT to_wdoc('The quick brown fox, the QUICK fox!');
                      to_wdoc                      
---------------------------------------------------
 'brown':1@3 'fox':2@4,7 'quick':2@2,6 'the':2@1,5
(1 row)

SELECT 'the quick brown fox'::wdoc;
                    wdoc                     
---------------------------------------------
 'brown':1@3 'fox':1@4 'quick':1@2 'the':1@1
(1 row)

SELECT to_wdoc('');                       -- empty doc
 to_wdoc 
---------
 
(1 row)

SELECT wdoc_length(to_wdoc('a b c a b a'));  -- doclen counts tokens
 wdoc_length 
-------------
           6
(1 row)

