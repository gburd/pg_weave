-- weave_vacuum: full compaction + tail truncation.  A parallel build
-- leaves dead source-segment pages; weave_vacuum reclaims them and truncates the
-- file, and the contents are unchanged afterward.
CREATE TABLE vac (id int, d wdoc);
INSERT INTO vac SELECT g, to_wdoc('common term'||(g%200)||' doc'||g)
  FROM generate_series(1,20000) g;
SET min_parallel_table_scan_size = 0;
SET max_parallel_maintenance_workers = 2;
CREATE INDEX vac_bm25 ON vac USING weave (d);
RESET max_parallel_maintenance_workers;
