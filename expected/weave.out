-- COUNT pushdown CustomScan (transparent count(*) WHERE @@@ answered from the
-- index).  The plan is a Custom Scan (WeaveCount); the count matches weave_count;
-- and it must NOT trigger when the shape is unsupported (extra qual, GROUP BY).
CREATE TABLE cnt (id int, body text);
INSERT INTO cnt SELECT g, 'common '||CASE WHEN g%4=0 THEN 'quarter ' ELSE '' END||'w'||(g%100)
  FROM generate_series(1,10000) g;
CREATE INDEX cnt_bm25 ON cnt USING weave(to_wdoc('english',body));
ANALYZE cnt;
SET enable_seqscan=off;
SELECT count(*) = weave_count('cnt_bm25', to_wquery('english','common')) AS count_matches
  FROM cnt WHERE to_wdoc('english',body) @@@ to_wquery('english','common');
 count_matches 
---------------
