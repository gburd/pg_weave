-- analyzer reusing an installed text search configuration.
-- english config stems and drops stopwords: 'running the races' -> run, race
SELECT to_wdoc('english'::regconfig, 'running the races quickly');
             to_wdoc              
----------------------------------
 'quick':1@4 'race':1@3 'run':1@1
(1 row)

-- stopwords ('the','a','of') are removed by the english dictionary
SELECT to_wdoc('english'::regconfig, 'the cat and a dog');
       to_wdoc       
---------------------
 'cat':1@2 'dog':1@5
(1 row)

-- doclen counts positions produced by the parser (stopwords still counted)
SELECT wdoc_length(to_wdoc('english'::regconfig, 'the quick brown fox'));
 wdoc_length 
-------------
           4
(1 row)

-- stemming makes a query match across inflections
SELECT to_wdoc('english'::regconfig, 'the foxes were running')
       @@@ 'fox & run'::wquery AS stemmed_match;
 stemmed_match 
---------------
 t
(1 row)

-- to_wdoc(tsvector): build an wdoc from an existing tsvector, no re-analysis.
-- Must be equivalent to to_wdoc(cfg, text) over the same text for matching.
SELECT to_wdoc(to_tsvector('english', 'the foxes were running'))
       @@@ 'fox & run'::wquery AS tsvector_stemmed_match;              -- t
 tsvector_stemmed_match 
------------------------
 t
(1 row)

-- phrase from a tsvector's positions (adjacency preserved through the map)
SELECT to_wdoc(to_tsvector('simple', 'quick brown fox'))
       @@@ '"quick brown"'::wquery AS tsvector_phrase;                 -- t
 tsvector_phrase 
-----------------
 t
(1 row)

SELECT to_wdoc(to_tsvector('simple', 'quick red brown'))
       @@@ '"quick brown"'::wquery AS tsvector_not_phrase;             -- f
 tsvector_not_phrase 
---------------------
 f
(1 row)

-- a stripped (positionless) tsvector still matches on presence (positions off)
SELECT to_wdoc(strip(to_tsvector('simple', 'quick brown fox')))
       @@@ 'brown'::wquery AS tsvector_stripped_match;                 -- t
 tsvector_stripped_match 
-------------------------
 t
(1 row)

-- empty tsvector -> empty wdoc, matches nothing
SELECT to_wdoc(to_tsvector('english', 'the a of')) @@@ 'x'::wquery AS tsvector_empty; -- f
 tsvector_empty 
----------------
 f
(1 row)

-- wdoc(tsvector) matches the same terms as wdoc(cfg,text) for the same text
-- (doclen may differ: a tsvector has already dropped stopword positions, which
-- the text analyzer still counts toward doclen -- so compare matching, not len).
SELECT to_wdoc(to_tsvector('english', 'the quick brown fox foxes')) @@@ 'fox & quick'::wquery
     = (to_wdoc('english'::regconfig, 'the quick brown fox foxes') @@@ 'fox & quick'::wquery)
       AS tsvector_matches_text;                                        -- t
 tsvector_matches_text 
-----------------------
 t
(1 row)

-- Stopword symmetry: to_wdoc drops configuration stopwords, so to_wquery
-- MUST drop them too (like to_tsquery), or a stopword conjunct silently zeroes
-- an AND.  A stopword term is elided from the query tree; a query that is only
-- stopwords becomes empty (matches nothing, as to_tsquery('english','the')='').
SELECT to_wquery('english','the')::text AS q_the_empty;               -- (empty)
 q_the_empty 
-------------
 
(1 row)

SELECT to_wquery('english','the & postgres')::text AS q_the_and_pg;   -- 'postgr'
 q_the_and_pg 
--------------
 'postgr'
(1 row)

SELECT to_wquery('english','postgres & the')::text AS q_pg_and_the;   -- 'postgr'
 q_pg_and_the 
--------------
 'postgr'
(1 row)

SELECT to_wquery('english','the | postgres')::text AS q_the_or_pg;    -- 'postgr'
 q_the_or_pg 
-------------
 'postgr'
(1 row)

SELECT to_wquery('english','the & a & of & postgres')::text AS q_many_stop; -- 'postgr'
 q_many_stop 
-------------
 'postgr'
(1 row)

SELECT to_wquery('english','(the | a) & postgres')::text AS q_grouped;-- 'postgr'
 q_grouped 
-----------
 'postgr'
(1 row)

SELECT to_wquery('english','postgres & (the | vacuum)')::text AS q_grp2; -- ('postgr' & 'vacuum')
        q_grp2         
-----------------------
 ('postgr' & 'vacuum')
(1 row)

SELECT to_wquery('english','postgres & !the')::text AS q_pg_not_the;  -- 'postgr'
 q_pg_not_the 
--------------
 'postgr'
(1 row)

SELECT to_wquery('english','"postgres the database"')::text AS q_phrase_mid; -- ('postgr' <-> 'databas')
       q_phrase_mid       
--------------------------
 ('postgr' <-> 'databas')
(1 row)

-- wquery elision matches the standard to_tsquery reduction (both drop 'the')
SELECT to_wquery('english','the & postgres')::text
     = to_wquery('english','postgres')::text AS matches_tsquery_reduction; -- t
 matches_tsquery_reduction 
---------------------------
 t
(1 row)

