 t
(1 row)

SELECT ('"quick brown"'::wquery @@@ to_wdoc('the quick brown fox'))
     = (to_wdoc('the quick brown fox') @@@ '"quick brown"'::wquery) AS match_commutator_phrase;
 match_commutator_phrase 
-------------------------
 t
(1 row)

SELECT ('NEAR(quick fox, 3)'::wquery @@@ to_wdoc('quick brown red fox'))
