-- prefix works through the weave index too
CREATE TABLE pfx (id serial, d wdoc);
INSERT INTO pfx (d) VALUES (to_wdoc('quicksand')), (to_wdoc('quiche')),
                          (to_wdoc('slow'));
CREATE INDEX pfx_bm25 ON pfx USING weave (d);
SET enable_seqscan = off;
SELECT id FROM pfx WHERE d @@@ 'qui*'::wquery ORDER BY id;
 id 
----
  1
  2
(2 rows)

RESET enable_seqscan;
DROP TABLE pfx;
-- index-maintained corpus statistics for BM25.
CREATE TABLE corpus (id serial, d wdoc);
INSERT INTO corpus (d)
SELECT to_wdoc('common ' || CASE WHEN g % 10 = 0 THEN 'rare' ELSE 'filler' END)
FROM generate_series(1, 100) g;
CREATE INDEX corpus_bm25 ON corpus USING weave (d);
-- stats reflect the corpus: 100 docs
SELECT ndocs, nterms FROM weave_index_stats('corpus_bm25');
 ndocs | nterms 
-------+--------
   100 |      3
(1 row)

-- 'rare' (df=10) scores higher than 'common' (df=100) using index df
SELECT weave_index_df('corpus_bm25', 'rare'::wquery) AS df_rare,
       weave_index_df('corpus_bm25', 'common'::wquery) AS df_common;
 df_rare | df_common 
---------+-----------
 {10}    | {100}
(1 row)

SELECT (SELECT weave_bm25(to_wdoc('common rare'), 'rare'::wquery,
                        s.ndocs, s.avgdl, weave_index_df('corpus_bm25', 'rare'::wquery)))
     > (SELECT weave_bm25(to_wdoc('common rare'), 'common'::wquery,
                        s.ndocs, s.avgdl, weave_index_df('corpus_bm25', 'common'::wquery)))
       AS rare_outranks_common
FROM weave_index_stats('corpus_bm25') s;
 rare_outranks_common 
----------------------
 t
(1 row)

DROP TABLE corpus;
-- incremental index maintenance (pending list).
CREATE TABLE inc (id serial, d wdoc);
INSERT INTO inc (d) VALUES (to_wdoc('alpha beta')), (to_wdoc('gamma delta'));
CREATE INDEX inc_bm25 ON inc USING weave (d);
SET enable_seqscan = off;
-- rows present at build time are found via the main structure
SELECT id FROM inc WHERE d @@@ 'alpha'::wquery ORDER BY id;
 id 
----
  1
(1 row)

-- INSERT after build must be immediately visible (no REINDEX) via pending list
INSERT INTO inc (d) VALUES (to_wdoc('alpha epsilon')), (to_wdoc('zeta'));
SELECT id FROM inc WHERE d @@@ 'alpha'::wquery ORDER BY id;   -- 1 and 3
 id 
----
  1
  3
(2 rows)

SELECT id FROM inc WHERE d @@@ 'zeta'::wquery ORDER BY id;     -- 4 (pending only)
 id 
----
  4
(1 row)

SELECT id FROM inc WHERE d @@@ 'alpha & !beta'::wquery ORDER BY id;  -- 3
 id 
----
  3
(1 row)

-- ndocs reflects built + pending
SELECT ndocs FROM weave_index_stats('inc_bm25');
 ndocs 
-------
     4
(1 row)

-- REINDEX merges pending into the main structure; results unchanged
REINDEX INDEX inc_bm25;
SELECT id FROM inc WHERE d @@@ 'alpha'::wquery ORDER BY id;
 id 
----
  1
  3
(2 rows)

RESET enable_seqscan;
DROP TABLE inc;
-- quoted phrase queries via per-term positions.
-- phrase renders with <-> and round-trips
SELECT '"quick brown fox"'::wquery;
              wquery               
-----------------------------------
 (('quick' <-> 'brown') <-> 'fox')
(1 row)

-- adjacency is enforced: "quick brown" matches, "quick fox" does not
SELECT to_wdoc('the quick brown fox') @@@ '"quick brown"'::wquery AS adj_hit;
 adj_hit 
---------
 t
(1 row)

SELECT to_wdoc('the quick brown fox') @@@ '"quick fox"'::wquery AS adj_miss;
 adj_miss 
----------
 f
(1 row)

SELECT to_wdoc('the quick brown fox') @@@ '"brown fox"'::wquery AS adj_hit2;
 adj_hit2 
----------
 t
(1 row)

-- word order matters: "fox brown" does not match "...brown fox"
SELECT to_wdoc('the quick brown fox') @@@ '"fox brown"'::wquery AS order_miss;
 order_miss 
------------
 f
(1 row)

-- three-word phrase
SELECT to_wdoc('the quick brown fox jumps') @@@ '"quick brown fox"'::wquery AS three_hit;
 three_hit 
-----------
 t
(1 row)

SELECT to_wdoc('quick red brown fox') @@@ '"quick brown fox"'::wquery AS three_miss;
 three_miss 
------------
 f
(1 row)

-- reserved keywords (and/or/not/near) are literal WORDS inside a phrase or NEAR
-- operand, not operators (ROADMAP #12b).  Use the 'simple' config so they are
-- not dropped as stopwords.  A bare keyword phrase must parse and match.
SELECT to_wquery('simple','"the and clause"')::text AS kw_phrase_parses;   -- (('the' <-> 'and') <-> 'clause')
         kw_phrase_parses         
----------------------------------
 (('the' <-> 'and') <-> 'clause')
(1 row)

SELECT to_wdoc('simple','read the and clause here') @@@ to_wquery('simple','"the and clause"') AS kw_phrase_hit;   -- t
 kw_phrase_hit 
---------------
 t
(1 row)

SELECT to_wdoc('simple','the clause and read') @@@ to_wquery('simple','"the and clause"') AS kw_phrase_miss;      -- f (order/adjacency)
 kw_phrase_miss 
----------------
 f
(1 row)

SELECT to_wdoc('simple','alpha or beta') @@@ to_wquery('simple','"alpha or beta"') AS kw_or_hit;                  -- t
 kw_or_hit 
-----------
 t
(1 row)

SELECT to_wdoc('simple','x near y z') @@@ to_wquery('simple','NEAR(near y, 2)') AS kw_in_near_hit;                -- t (literal 'near' inside NEAR)
 kw_in_near_hit 
----------------
 t
(1 row)

-- phrase combined with boolean operators
SELECT to_wdoc('the quick brown fox') @@@ '"quick brown" & fox'::wquery AS combo;
 combo 
-------
 t
(1 row)

-- phrase works through the weave index (recheck enforces adjacency)
CREATE TABLE ph (id serial, d wdoc);
INSERT INTO ph (d) VALUES (to_wdoc('quick brown fox')),
                          (to_wdoc('brown quick fox')),
                          (to_wdoc('quick brown bear'));
CREATE INDEX ph_bm25 ON ph USING weave (d);
SET enable_seqscan = off;
SELECT id FROM ph WHERE d @@@ '"quick brown"'::wquery ORDER BY id;   -- 1 and 3
 id 
----
  1
  3
(2 rows)

RESET enable_seqscan;
DROP TABLE ph;
-- regconfig analyzer must also carry positions so phrase/NEAR enforce
-- adjacency (v0.2.1 bug: to_wdoc(regconfig,text) stored no positions, so
-- phrases silently degraded to AND).  'simple' config: no stemming/stopwords,
-- positions map 1:1 to input words.
-- adjacent phrase matches
SELECT to_wdoc('simple'::regconfig, 'quick brown fox')
       @@@ to_wquery('simple'::regconfig, '"quick brown"') AS cfg_adj_hit;   -- t
 cfg_adj_hit 
-------------
 t
(1 row)

-- non-adjacent must NOT match (was t before the fix -- the bug -- now f)
SELECT to_wdoc('simple'::regconfig, 'quick red slow brown')
       @@@ to_wquery('simple'::regconfig, '"quick brown"') AS cfg_nonadj_miss; -- f
 cfg_nonadj_miss 
-----------------
 f
(1 row)

-- three-word phrase: only consecutive matches
SELECT to_wdoc('simple'::regconfig, 'a b c')
