INSERT INTO lazy (d) VALUES (to_wdoc('term term term term term'));  -- id 2001
CREATE INDEX lazy_bm25 ON lazy USING weave (d);
-- top-1 must be the high-tf doc (id 2001), found via block-max skipping
SELECT l.id
FROM weave_search('lazy_bm25', 'term'::wquery, 1) r JOIN lazy l ON l.ctid = r.ctid;
  id  
