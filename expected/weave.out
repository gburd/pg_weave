-- index-backed phrase on a regconfig-analyzed column: recheck must exclude
-- non-adjacent docs
CREATE TABLE phc (id serial, d wdoc);
INSERT INTO phc (d) VALUES
  (to_wdoc('simple'::regconfig, 'quick brown fox')),      -- 1: adjacent
  (to_wdoc('simple'::regconfig, 'quick red slow brown')), -- 2: not adjacent
  (to_wdoc('simple'::regconfig, 'quick brown bear'));     -- 3: adjacent
CREATE INDEX phc_bm25 ON phc USING weave (d);
SET enable_seqscan = off;
SELECT id FROM phc WHERE d @@@ to_wquery('simple'::regconfig, '"quick brown"')
  ORDER BY id;   -- 1 and 3 only
 id 
----
  1
  3
(2 rows)

RESET enable_seqscan;
DROP TABLE phc;
-- phrase adjacency must hold on a STORED (column-resident) wdoc that is long
-- enough for its positions[] region to land at a non-MAXALIGN'd byte offset.
-- Regression for the WEAVE_DOC_POSITIONS alignment bug: the accessor used
-- MAXALIGN() of an absolute pointer, which mismatched the analyzer's
-- offset-based layout once a detoasted/heap-read doc sat at a non-MAXALIGN'd
-- address -- positions[] then pointed at garbage and phrase/NEAR silently
-- degraded to AND on every stored wdoc (the short-doc tests above happened to
-- land aligned and did not catch it).  Each doc below has repeated filler terms
-- (so tf>1, several positions) plus the phrase at the end; the count must be
-- exactly the adjacent docs, not the larger AND-set.
CREATE TABLE phlong (id int, body text, d wdoc);
INSERT INTO phlong(id, body)
SELECT g,
       (SELECT string_agg('flr' || (s % 5), ' ') FROM generate_series(1, 17 + g) s)
       || CASE WHEN g % 2 = 0 THEN ' united states'          -- adjacent
               ELSE ' united middle states' END              -- not adjacent
FROM generate_series(1, 8) g;
UPDATE phlong SET d = to_wdoc('simple'::regconfig, body);
-- stored-column adjacency: exactly the even ids (the adjacent phrase)
SELECT id FROM phlong
WHERE d @@@ to_wquery('simple'::regconfig, '"united states"') ORDER BY id;   -- 2,4,6,8
 id 
----
  2
  4
  6
  8
(4 rows)

-- and the stored value must agree with a fresh re-analysis of the same body
SELECT bool_and(
         (d @@@ to_wquery('simple'::regconfig, '"united states"'))
         = (to_wdoc('simple'::regconfig, body) @@@ to_wquery('simple'::regconfig, '"united states"'))
       ) AS stored_matches_fresh FROM phlong;   -- t
 stored_matches_fresh 
----------------------
 t
(1 row)

DROP TABLE phlong;
-- external-content indexing via an expression index.
-- The weave index stores only postings (no document text), so indexing
-- to_wdoc(body) over a plain text column is the external-content model:
-- the text lives in the table, the index derives wdoc from it.
CREATE TABLE articles (id serial, body text);
INSERT INTO articles (body) VALUES
  ('the quick brown fox'),
  ('lazy dogs sleep'),
  ('quick foxes are clever');
CREATE INDEX articles_bm25 ON articles USING weave (to_wdoc(body));
SET enable_seqscan = off;
-- query against the expression index; text is fetched from the table only
-- for returned rows
SELECT id, body FROM articles
WHERE to_wdoc(body) @@@ 'quick'::wquery ORDER BY id;
 id |          body          
----+------------------------
  1 | the quick brown fox
  3 | quick foxes are clever
(2 rows)

SELECT id FROM articles
WHERE to_wdoc(body) @@@ '"quick brown"'::wquery ORDER BY id;
 id 
----
  1
(1 row)

RESET enable_seqscan;
DROP TABLE articles;
