(1 row)

-- the reported bug: a stopword-containing AND now matches the content
SELECT weave_match(to_wdoc('english','the postgres docs'),
                 to_wquery('english','the & postgres')) AS stopword_and_matches;  -- t
 stopword_and_matches 
----------------------
 t
(1 row)

SELECT weave_match(to_wdoc('english','the vacuum problem in postgres'),
                 to_wquery('english','the vacuum problem')) AS nl_query_matches;  -- t
 nl_query_matches 
------------------
 t
(1 row)

-- an all-stopword query matches nothing (consistent with to_tsquery)
SELECT weave_match(to_wdoc('english','the postgres docs'),
                 to_wquery('english','the')) AS allstopword_matches_nothing;      -- f
 allstopword_matches_nothing 
-----------------------------
 f
(1 row)

-- count parity through the index: 'the & postgres' == 'postgres'
CREATE TABLE sw (id serial, d wdoc);
INSERT INTO sw(d) SELECT to_wdoc('english', b) FROM (VALUES
  ('the postgres vacuum'), ('a checkpoint runs'), ('the the the'),
  ('postgres runs a vacuum'), ('nothing relevant here')) v(b);
CREATE INDEX sw_idx ON sw USING weave (d);
SET enable_seqscan = off;
SELECT count(*) AS the_cnt FROM sw WHERE d @@@ to_wquery('english','the');               -- 0
 the_cnt 
---------
       0
(1 row)

SELECT (SELECT count(*) FROM sw WHERE d @@@ to_wquery('english','the & postgres'))
     = (SELECT count(*) FROM sw WHERE d @@@ to_wquery('english','postgres'))
       AS stopword_and_count_parity;                                                       -- t
 stopword_and_count_parity 
---------------------------
 t
(1 row)

RESET enable_seqscan;
DROP TABLE sw;
-- BM25 scoring.
-- score is positive when a query term is present, zero when absent
SELECT round(weave_bm25(to_wdoc('quick brown fox'), 'fox'::wquery,
                      1000, 4.0)::numeric, 4) AS present_gt_0;
 present_gt_0 
--------------
       7.2442
(1 row)

SELECT weave_bm25(to_wdoc('quick brown fox'), 'turtle'::wquery,
                1000, 4.0) AS absent_is_0;
 absent_is_0 
-------------
           0
(1 row)

-- length normalization: same tf, longer doc scores lower
SELECT weave_bm25(to_wdoc('fox'), 'fox'::wquery, 1000, 10.0)
     > weave_bm25(to_wdoc('fox ' || repeat('pad ', 40)), 'fox'::wquery, 1000, 10.0)
       AS shorter_scores_higher;
 shorter_scores_higher 
-----------------------
 t
(1 row)

-- IDF: a rarer term (low df) contributes more than a common one (high df)
SELECT weave_bm25(to_wdoc('rare common'), 'rare'::wquery, 1000, 2.0, ARRAY[2.0])
     > weave_bm25(to_wdoc('rare common'), 'common'::wquery, 1000, 2.0, ARRAY[900.0])
       AS rare_scores_higher;
 rare_scores_higher 
--------------------
 t
(1 row)

-- higher term frequency scores higher (saturating)
SELECT weave_bm25(to_wdoc('fox fox fox'), 'fox'::wquery, 1000, 3.0)
     > weave_bm25(to_wdoc('fox pad pad'), 'fox'::wquery, 1000, 3.0)
       AS more_tf_scores_higher;
 more_tf_scores_higher 
-----------------------
 t
(1 row)

-- BM25 variants.
-- all variants score presence > absence
SELECT variant,
       weave_bm25_opts(to_wdoc('quick fox'), 'fox'::wquery,
                     1000, 3.0, 1.2, 0.75, variant, ARRAY[10.0]) > 0 AS positive
FROM unnest(ARRAY['lucene','robertson','atire','bm25+','bm25l']) AS variant
ORDER BY variant;
  variant  | positive 
-----------+----------
 atire     | t
 bm25+     | t
 bm25l     | t
 lucene    | t
 robertson | t
(5 rows)

-- bm25+ >= lucene for the same inputs (delta floor)
SELECT weave_bm25_opts(to_wdoc('fox'), 'fox'::wquery, 1000, 5.0, 1.2, 0.75, 'bm25+', ARRAY[3.0])
     > weave_bm25_opts(to_wdoc('fox'), 'fox'::wquery, 1000, 5.0, 1.2, 0.75, 'lucene', ARRAY[3.0])
       AS bm25plus_ge_lucene;
 bm25plus_ge_lucene 
--------------------
 t
(1 row)

-- bm25l (rank_bm25 compatible: delta shift on the length-normalized tf) scores
-- a present term positively and 'l' is an accepted alias for it
SELECT weave_bm25_opts(to_wdoc('fox fox fox'), 'fox'::wquery, 1000, 5.0, 1.5, 0.75, 'bm25l', ARRAY[3.0]) > 0 AS bm25l_positive,
       weave_bm25_opts(to_wdoc('fox fox fox'), 'fox'::wquery, 1000, 5.0, 1.5, 0.75, 'bm25l', ARRAY[3.0])
     = weave_bm25_opts(to_wdoc('fox fox fox'), 'fox'::wquery, 1000, 5.0, 1.5, 0.75, 'l', ARRAY[3.0]) AS l_alias;
 bm25l_positive | l_alias 
----------------+---------
 t              | t
(1 row)

-- unknown variant errors
SELECT weave_bm25_opts(to_wdoc('x'), 'x'::wquery, 10, 1.0, 1.2, 0.75, 'bogus');
ERROR:  unknown weave variant "bogus"
HINT:  Valid variants: lucene, robertson, atire, bm25+, bm25l.
