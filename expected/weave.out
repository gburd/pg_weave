ERROR:  syntax error in wquery: "vac:A~1"
-- index-path parity: field restriction through the weave index == seqscan truth,
-- for count(*), weave_count, and a scan.
CREATE TABLE zmsg (id serial, subject text, body text, d wdoc);
INSERT INTO zmsg(subject, body) VALUES
 ('vacuum tuning', 'locks and contention'),
 ('lock contention', 'run vacuum often'),
 ('checkpoint', 'vacuum and checkpoint');
UPDATE zmsg SET d = to_wdoc('english', subject, 'A') || to_wdoc('english', body, 'C');
CREATE INDEX zmsg_weave ON zmsg USING weave (d) WITH (positions = on);
SET enable_seqscan = off;
SELECT array_agg(id ORDER BY id) AS idx_subjA FROM zmsg WHERE d @@@ to_wquery('english','vacuum:A');  -- {1}
 idx_subja 
-----------
 {1}
(1 row)

SELECT weave_count('zmsg_weave', to_wquery('english','vacuum:A')) AS cnt_subjA;                           -- 1
 cnt_subja 
-----------
         1
(1 row)

SELECT weave_count('zmsg_weave', to_wquery('english','vacuum')) AS cnt_any;                               -- 3
 cnt_any 
---------
       3
(1 row)

SET enable_indexscan = off; SET enable_bitmapscan = off;
SELECT array_agg(id ORDER BY id) AS seq_subjA FROM zmsg WHERE d @@@ to_wquery('english','vacuum:A');  -- {1}
 seq_subja 
-----------
 {1}
(1 row)

RESET enable_indexscan; RESET enable_bitmapscan; RESET enable_seqscan;
DROP TABLE zmsg;
-- ============================================================================
-- Upgrade compatibility: an index/value built WITHOUT weight labels (as by
-- pre-1.4.0, and by the 2-arg to_wdoc) reads correctly under 1.4.0 -- every
-- position is label D, so unrestricted queries are unchanged, term:D matches,
-- and term:A/B/C does not.  This is the "no REINDEX" guarantee: existing
-- unlabelled indexes keep working; only rebuilding from labelled docs adds
-- field provenance.
CREATE TABLE zold (id serial, d wdoc);
INSERT INTO zold(d) SELECT to_wdoc('english','vacuum lock number '||g) FROM generate_series(1,200) g;
CREATE INDEX zold_weave ON zold USING weave (d) WITH (positions = on);
SET enable_seqscan = off;
-- unrestricted query unchanged (all 200 rows contain vacuum)
SELECT count(*) = 200 AS unrestricted_ok FROM zold WHERE d @@@ to_wquery('english','vacuum');
 unrestricted_ok 
-----------------
 t
(1 row)

-- term:D matches unlabelled data (unlabelled == D)
SELECT count(*) = 200 AS labelD_matches FROM zold WHERE d @@@ to_wquery('english','vacuum:D');
 labeld_matches 
----------------
 t
(1 row)

-- term:A does NOT match unlabelled data
SELECT count(*) = 0 AS labelA_no_match FROM zold WHERE d @@@ to_wquery('english','vacuum:A');
 labela_no_match 
-----------------
 t
(1 row)

-- phrase still works on the unlabelled positions index
SELECT count(*) = 200 AS phrase_ok FROM zold WHERE d @@@ '"vacuum lock"'::wquery;
 phrase_ok 
-----------
 t
(1 row)

RESET enable_seqscan;
DROP TABLE zold;
