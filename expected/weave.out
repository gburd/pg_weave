-- ============================================================================
-- Coverage: pg_weave_docvalid.h (weave_doc_check, via weave_doc_is_valid) -- the
-- "normal" (accept) side of every guard: header-fits, VARSIZE<=sz,
-- version match, entries[]+lexbytes fits, each term's lexeme slice fits, the
-- positions-present branch (both taken and not-taken), positions region fits,
-- and each term's tf/posoff run fits.  weave_doc_is_valid is called on every
-- document while it sits in the PENDING LIST (both when it is flushed to a
-- segment by weave_merge/weave_vacuum and when a scan walks the pending list
-- directly), so a variety of pending docs -- empty, single-token, multi-term,
-- with and without positions, high tf -- exercises the accept path of every
-- guard in weave_doc_check for both the flags-has-positions and
-- flags-no-positions shapes.  The reject ("return 0") side of each guard is a
-- pure corruption/defensive check: it requires a hand-corrupted WeaveDoc image
-- (bad nterms/off/len/tf/posoff/VARSIZE) that no SQL-level constructor can
-- produce -- weave_doc_build validates before returning, wdoc_recv bounds nterms
-- and every length against the message size, and to_wdoc/to_wdoc(tsvector)
-- always build a well-formed image.  That side is exactly what
-- test/fuzz/fuzz_docvalid.c targets instead (its own header comment says so).
-- ============================================================================
CREATE TABLE dv (id serial, d wdoc);
CREATE INDEX dv_idx ON dv USING weave (d);
-- empty doc: nterms=0, no positions -- entries[]/lexeme loops execute 0 times
INSERT INTO dv (d) VALUES (to_wdoc(''));
-- single-token doc: nterms=1, tf=1, WITH positions (default text path sets
-- WEAVE_DOCF_POSITIONS) -- the positions-present branch, one posoff/tf run
INSERT INTO dv (d) VALUES (to_wdoc('lonely'));
-- multi-term doc with a high-tf term (many positions for one entry) --
-- exercises a term whose [posoff, posoff+tf) run is the bulk of positions[]
INSERT INTO dv (d) VALUES (to_wdoc(repeat('alpha ', 50) || 'beta gamma delta'));
-- built from a tsvector directly (to_wdoc_from_tsvector): a different doc
-- builder feeding the same weave_doc_is_valid checks
INSERT INTO dv (d) VALUES (to_wdoc(to_tsvector('english', 'search engines index text')));
-- tsvector built from an EMPTY string: another nterms=0 shape, but produced by
-- the tsvector-adoption path (to_wdoc_from_tsvector), not weave_analyze_text
INSERT INTO dv (d) VALUES (to_wdoc(to_tsvector('english', '')));
-- a stripped tsvector (no positions at all) -> positions-absent branch via the
-- tsvector path specifically (all-or-nothing degrades to positions-off)
INSERT INTO dv (d) VALUES (to_wdoc(strip(to_tsvector('english', 'no positions here'))));
-- every doc above went through aminsert (index created before the inserts),
-- so it sits in the PENDING LIST, not a built segment.
-- pending-list SCAN path: query while still pending, so weave_doc_is_valid runs
-- over the raw pending page bytes for every row above.
SET enable_seqscan = off;
SELECT count(*) AS dv_pending_scan_hits FROM dv WHERE d @@@ 'alpha'::wquery;
 dv_pending_scan_hits 
----------------------
                    1
(1 row)

RESET enable_seqscan;
-- pending-list FLUSH path: weave_merge folds every pending doc into a segment,
-- running weave_doc_is_valid over each one again during the flush.
SELECT weave_merge('dv_idx'::regclass) IS NOT NULL AS dv_merged;
 dv_merged 
-----------
 t
(1 row)

SET enable_seqscan = off;
SELECT count(*) AS dv_after_merge FROM dv WHERE d @@@ 'alpha'::wquery;
 dv_after_merge 
----------------
              1
(1 row)

RESET enable_seqscan;
DROP TABLE dv;
-- binary recv/send round-trips of the same doc shapes, through the wire format
-- (wdoc_recv re-derives nterms/doclen/has_pos from message bytes and rebuilds
-- via weave_doc_build, so this is a second, independent path to the same
-- well-formed images that then flow through weave_doc_is_valid once indexed).
CREATE TEMP TABLE dvrt (id int, d wdoc);
INSERT INTO dvrt VALUES
  (1, to_wdoc('')),
  (2, to_wdoc('single')),
  (3, to_wdoc('alpha beta alpha gamma alpha delta'));
-- binary send/recv round-trip via COPY (FORMAT binary): send serializes each
-- wdoc, recv (internal) re-derives nterms/doclen/has_pos and rebuilds it.
CREATE TEMP TABLE dvrt_bin (LIKE dvrt INCLUDING ALL);
COPY dvrt TO '/tmp/dvrt.bin' WITH (FORMAT binary);
COPY dvrt_bin FROM '/tmp/dvrt.bin' WITH (FORMAT binary);
SELECT bool_and(a.d::text = b.d::text) AS dv_binary_roundtrip_ok
  FROM dvrt a JOIN dvrt_bin b USING (id);
 dv_binary_roundtrip_ok 
------------------------
 t
(1 row)

CREATE INDEX dvrt_idx ON dvrt USING weave (d);
SET enable_seqscan = off;
SELECT count(*) AS dvrt_hits FROM dvrt WHERE d @@@ 'alpha'::wquery;
 dvrt_hits 
-----------
         1
(1 row)

RESET enable_seqscan;
-- ============================================================================
-- Coverage: pg_weave_aux.c -- weave_highlight / weave_snippet, i.e. tokenize_and_mark
-- and its callers.  Exercise: is_token_byte's >=0x80 (unicode) branch, a
-- leading/trailing/only-separator source (the "i > sepstart" emit and the
-- "i >= len" break), a query that matches nothing (ctx.n == 0 in snippet),
-- a multi-term query, a phrase query, and the match at the very start, middle
-- and end of the source text.
-- ============================================================================
-- match at the START of the text (first token matched, sepstart==i==0 skip)
SELECT weave_highlight('needle in a haystack', 'needle'::wquery) AS hl_match_start;
       hl_match_start        
-----------------------------
 <b>needle</b> in a haystack
(1 row)

-- match in the MIDDLE
SELECT weave_highlight('a haystack with needle inside', 'needle'::wquery) AS hl_match_middle;
           hl_match_middle            
--------------------------------------
 a haystack with <b>needle</b> inside
(1 row)

-- match at the very END (no trailing separator run)
SELECT weave_highlight('a haystack with a needle', 'needle'::wquery) AS hl_match_end;
          hl_match_end           
---------------------------------
 a haystack with a <b>needle</b>
(1 row)

-- leading separator run before the first token ("i > sepstart" sink call)
SELECT weave_highlight('   leading spaces then needle', 'needle'::wquery) AS hl_leading_sep;
            hl_leading_sep            
--------------------------------------
    leading spaces then <b>needle</b>
(1 row)

-- trailing separator run after the last token
SELECT weave_highlight('needle then trailing spaces   ', 'needle'::wquery) AS hl_trailing_sep;
            hl_trailing_sep            
---------------------------------------
 <b>needle</b> then trailing spaces   
(1 row)

-- text that is PURE separators (no token at all): the loop hits "i >= len"
-- immediately on its first (and only) separator scan
SELECT weave_highlight('    ...   ', 'needle'::wquery) AS hl_all_separators;
 hl_all_separators 
-------------------
     ...   
(1 row)

-- empty text: len == 0, loop body never runs
SELECT weave_highlight('', 'needle'::wquery) AS hl_empty_text;
 hl_empty_text 
---------------
 
(1 row)

-- multi-term query (OR): several distinct tokens matched in one pass
SELECT weave_highlight('alpha in the middle beta at the end', 'alpha | beta'::wquery) AS hl_multiterm;
                   hl_multiterm                    
---------------------------------------------------
