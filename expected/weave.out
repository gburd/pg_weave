-- Coverage: pg_weave_rank.c -- weave_bm25f (3+ fields, an empty-doc field, a
-- per-field dfs array, sharply differing weights, an absent query term, a
-- multi-term query) and weave_distance / weave_distance_commutator directly.
-- ============================================================================
-- 3 fields (title/body/tags), one field an EMPTY wdoc (to_wdoc('')),
-- multi-term query, per-term dfs, weights that differ a lot.
SELECT round(weave_bm25f(
         ARRAY[to_wdoc('postgres fts'), to_wdoc(''), to_wdoc('search engine postgres')],
         'postgres & search'::wquery,
         ARRAY[10.0, 3.0, 1.0],       -- title >> tags >> empty body
         500.0,
         ARRAY[4.0, 1.0, 6.0],        -- avgdl per field
         ARRAY[50.0, 20.0])::numeric, 6) AS bm25f_3field;
 bm25f_3field 
--------------
     8.744023
(1 row)

-- a query term absent from every field scores exactly 0 (tfw stays 0 for all
-- fields -> the "continue" before idf is ever computed for that term)
SELECT weave_bm25f(
         ARRAY[to_wdoc('alpha beta'), to_wdoc('gamma delta')],
         'zzzzabsent'::wquery,
         ARRAY[1.0, 1.0], 100.0, ARRAY[2.0, 2.0]) AS bm25f_absent_term;
 bm25f_absent_term 
-------------------
                 0
(1 row)

-- title-weighted hit outranks the identical term only in the body
SELECT weave_bm25f(ARRAY[to_wdoc('widget'), to_wdoc('unrelated filler text')],
                'widget'::wquery, ARRAY[8.0, 1.0], 200.0, ARRAY[3.0, 12.0])
     > weave_bm25f(ARRAY[to_wdoc('unrelated filler'), to_wdoc('widget text')],
                'widget'::wquery, ARRAY[8.0, 1.0], 200.0, ARRAY[3.0, 12.0])
       AS bm25f_title_weight_wins;
 bm25f_title_weight_wins 
-------------------------
 t
(1 row)

-- field that is NULL (not merely empty) is skipped (docnull[f] branch)
SELECT weave_bm25f(ARRAY[to_wdoc('alpha'), NULL],
                'alpha'::wquery, ARRAY[1.0, 1.0], 100.0, ARRAY[1.0, 1.0]) > 0
       AS bm25f_null_field_skipped;
 bm25f_null_field_skipped 
--------------------------
 t
(1 row)

-- avgdl <= 0 for one field clamps to 1.0 (avgdl <= 0.0 branch)
SELECT weave_bm25f(ARRAY[to_wdoc('alpha beta')],
                'alpha'::wquery, ARRAY[1.0], 100.0, ARRAY[0.0]) >= 0
       AS bm25f_avgdl_zero_clamped;
 bm25f_avgdl_zero_clamped 
--------------------------
 t
(1 row)

