-- Coverage: count(*) pushdown rejection paths (pg_weave_customscan.c)
-- These query shapes must NOT use the WeaveCount pushdown (still correct results).
-- ============================================================================
CREATE TABLE cs (id serial, cat int, d wdoc);
INSERT INTO cs(cat, d) SELECT g % 3, to_wdoc('english','term'||(g%5)||' body') FROM generate_series(1,300) g;
CREATE INDEX cs_idx ON cs USING weave (d);
SET enable_seqscan = off;
-- GROUP BY -> no pushdown, still correct
SELECT cat, count(*) FROM cs WHERE d @@@ to_wquery('english','term1') GROUP BY cat ORDER BY cat;
