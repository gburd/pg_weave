-- ============================================================================
-- Coverage: pg_weave_match.c -- weave_doc_matches (the RPN stack evaluator) and
-- weave_match / weave_match_commutator directly on an wdoc value (no index).
-- AND both-present/one-missing, OR, NOT, nested boolean, phrase present/
-- absent, NEAR present/absent, prefix, an empty query, an empty doc, and a
-- phrase/NEAR degrading to AND-only when the doc has no stored positions
-- (phrase_step's "either side lacks positions" branch).
-- ============================================================================
-- AND: both present, and one missing
SELECT to_wdoc('alpha beta') @@@ 'alpha & beta'::wquery AS and_both_present;
 and_both_present 
------------------
 t
(1 row)

SELECT to_wdoc('alpha only') @@@ 'alpha & beta'::wquery AS and_one_missing;
 and_one_missing 
-----------------
 f
(1 row)

-- OR: either side present, both absent
SELECT to_wdoc('alpha only') @@@ 'alpha | beta'::wquery AS or_left_present;
 or_left_present 
-----------------
 t
(1 row)

SELECT to_wdoc('beta only') @@@ 'alpha | beta'::wquery AS or_right_present;
 or_right_present 
------------------
 t
(1 row)

SELECT to_wdoc('gamma only') @@@ 'alpha | beta'::wquery AS or_both_absent;
 or_both_absent 
----------------
 f
(1 row)

-- NOT: present flips to absent and vice versa
SELECT to_wdoc('alpha') @@@ '!alpha'::wquery AS not_present_flips;
 not_present_flips 
-------------------
 f
(1 row)

SELECT to_wdoc('beta') @@@ '!alpha'::wquery AS not_absent_flips;
 not_absent_flips 
------------------
 t
(1 row)

-- nested boolean: (a & b) | (!c)
SELECT to_wdoc('alpha beta') @@@ '(alpha & beta) | !gamma'::wquery AS nested_and_or;
 nested_and_or 
---------------
 t
(1 row)

SELECT to_wdoc('gamma') @@@ '(alpha & beta) | !gamma'::wquery AS nested_falls_to_not;
 nested_falls_to_not 
---------------------
 f
(1 row)

-- phrase: present (adjacent) and absent (not adjacent) on a POSITIONAL doc
SELECT to_wdoc('the quick brown fox') @@@ '"quick brown"'::wquery AS phrase_present;
 phrase_present 
----------------
 t
(1 row)

SELECT to_wdoc('the quick red brown fox') @@@ '"quick brown"'::wquery AS phrase_absent;
 phrase_absent 
---------------
 f
(1 row)

-- NEAR: present (within k) and absent (beyond k)
SELECT to_wdoc('quick brown red fox') @@@ 'NEAR(quick fox, 3)'::wquery AS near_present;
 near_present 
--------------
 t
(1 row)

SELECT to_wdoc('quick brown red slow lazy fox') @@@ 'NEAR(quick fox, 2)'::wquery AS near_absent;
 near_absent 
-------------
 f
(1 row)

-- prefix: matches any term starting with the prefix
SELECT to_wdoc('development environment') @@@ 'develop*'::wquery AS prefix_hit;
 prefix_hit 
------------
 t
(1 row)

SELECT to_wdoc('unrelated words') @@@ 'develop*'::wquery AS prefix_miss;
 prefix_miss 
-------------
 f
(1 row)

-- empty query matches nothing (weave_doc_matches: nitems == 0 -> false)
SELECT to_wdoc('anything at all') @@@ ''::wquery AS empty_query_no_match;
 empty_query_no_match 
----------------------
 f
(1 row)

-- empty doc matches nothing against any real query (term lookup finds nothing)
SELECT to_wdoc('') @@@ 'anything'::wquery AS empty_doc_no_match;
 empty_doc_no_match 
--------------------
 f
(1 row)

-- empty query against an empty doc
SELECT to_wdoc('') @@@ ''::wquery AS empty_query_empty_doc;
 empty_query_empty_doc 
-----------------------
 f
(1 row)

-- phrase/NEAR on a doc built WITHOUT positions (canonical literal, no '@'):
-- phrase_step's "either side lacks positions" branch degrades to plain AND,
-- so a non-adjacent phrase still matches when both terms are merely present.
SELECT $$'brown':1 'quick':1$$::wdoc @@@ '"quick brown"'::wquery AS phrase_nopos_degrades_to_and;
 phrase_nopos_degrades_to_and 
------------------------------
 t
(1 row)

SELECT $$'fox':1 'quick':1$$::wdoc @@@ 'NEAR(quick fox, 1)'::wquery AS near_nopos_degrades_to_and;
 near_nopos_degrades_to_and 
----------------------------
 t
(1 row)

-- the commutator form (wquery @@@ wdoc) agrees with weave_match in both
