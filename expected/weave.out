-- ============================================================================
-- Coverage: engine scan paths (pg_weave_am.c / pg_weave_am_scan.c) -- WAND vs
-- MaxScore, positions-on ranked/phrase, adaptive-k growth, multi-segment
-- ranked, anomaly detection, deep weave_search with tombstones.
-- ============================================================================
-- MaxScore path: a ranked query with >= 4 terms takes weave_search_maxscore
CREATE TABLE ms4 (id serial, d wdoc);
INSERT INTO ms4(d) SELECT to_wdoc('english',
  (CASE WHEN g%2=0 THEN 'alpha ' ELSE '' END) ||
  (CASE WHEN g%3=0 THEN 'beta ' ELSE '' END) ||
  (CASE WHEN g%5=0 THEN 'gamma ' ELSE '' END) ||
  (CASE WHEN g%7=0 THEN 'delta ' ELSE '' END) || 'w'||(g%40)||' body '||g)
  FROM generate_series(1,1200) g;
CREATE INDEX ms4_idx ON ms4 USING weave (d);
SET enable_seqscan = off;
-- 4-term OR -> MaxScore; top-k must equal a brute-force score sort
SELECT count(*) = 10 AS maxscore_k10 FROM (
  SELECT id FROM ms4 WHERE d @@@ to_wquery('english','alpha | beta | gamma | delta')
  ORDER BY d <=> to_wquery('english','alpha | beta | gamma | delta') LIMIT 10) x;
 maxscore_k10 
--------------
 t
(1 row)

-- adaptive-k growth: pull well past the first batch (LIMIT 300)
SELECT count(*) AS deep_limit FROM (
  SELECT id FROM ms4 WHERE d @@@ to_wquery('english','w1 | alpha | beta | gamma | delta')
  ORDER BY d <=> to_wquery('english','w1 | alpha | beta | gamma | delta') LIMIT 300) x;
 deep_limit 
------------
        300
(1 row)

RESET enable_seqscan;
DROP TABLE ms4;
-- positions = on: phrase/NEAR answered from the index (no heap recheck path)
CREATE TABLE posidx (id serial, body text);
INSERT INTO posidx(body) SELECT 'quick brown fox number '||g||' jumps' FROM generate_series(1,400) g;
INSERT INTO posidx(body) SELECT 'brown quick fox '||g FROM generate_series(1,100) g;   -- reversed
CREATE INDEX posidx_bm25 ON posidx USING weave (to_wdoc('english', body)) WITH (positions = on);
SET enable_seqscan = off;
SELECT count(*) AS phrase_hits FROM posidx
 WHERE to_wdoc('english', body) @@@ '"quick brown"'::wquery;    -- 400 (adjacent only)
 phrase_hits 
-------------
         400
(1 row)

SELECT count(*) AS near_hits FROM posidx
 WHERE to_wdoc('english', body) @@@ 'NEAR(quick fox, 3)'::wquery;
 near_hits 
-----------
       500
(1 row)

