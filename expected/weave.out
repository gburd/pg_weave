-- MVCC: weave_search must return only tuples visible to the snapshot.
CREATE TABLE viz (id serial, d wdoc);
INSERT INTO viz (d) VALUES (to_wdoc('apple')), (to_wdoc('apple')),
                          (to_wdoc('apple')), (to_wdoc('apple'));
CREATE INDEX viz_bm25 ON viz USING weave (d);
-- delete two rows; their postings remain in the index until merge/reindex
DELETE FROM viz WHERE id IN (2, 3);
-- weave_search must skip the dead tuples (returns 2 live rows, not 4)
SELECT count(*) AS live_only
FROM weave_search('viz_bm25', 'apple'::wquery, 100) r
JOIN viz v ON v.ctid = r.ctid;
 live_only 
-----------
         2
(1 row)

-- and the raw SRF itself returns only visible ctids
SELECT count(*) AS srf_live FROM weave_search('viz_bm25', 'apple'::wquery, 100);
 srf_live 
----------
        2
(1 row)

