SELECT octet_length(wdoc_send(to_wdoc('round trip test'))) > 0 AS wdoc_send_ok;
 wdoc_send_ok 
--------------
 t
(1 row)

SELECT octet_length(wquery_send('a & (b | !c)'::wquery)) > 0 AS wquery_send_ok;
 wquery_send_ok 
----------------
 t
(1 row)

