-- FSM page recycling: repeated merges reuse freed blocks (no unbounded growth).
CREATE TABLE recyc (id serial, d wdoc);
INSERT INTO recyc (d) SELECT to_wdoc('term' || (g % 50)) FROM generate_series(1, 500) g;
CREATE INDEX recyc_bm25 ON recyc USING weave (d);
-- churn: insert + merge several times; each merge frees the old blocks
DO $$
BEGIN
  FOR i IN 1..5 LOOP
    INSERT INTO recyc (d) SELECT to_wdoc('term' || (g % 50)) FROM generate_series(1, 200) g;
    PERFORM weave_merge('recyc_bm25');
  END LOOP;
END $$;
SELECT pg_relation_size('recyc_bm25') AS recyc_churned \gset
-- after churn the index is still correct
SELECT count(*) > 0 AS still_matches
FROM weave_search('recyc_bm25', 'term1'::wquery, 5000) r JOIN recyc x ON x.ctid = r.ctid;
 still_matches 
---------------
 t
(1 row)

-- weave_merge compacts the segment directory but deliberately does NOT shrink the
-- file (that is weave_vacuum's job); after weave_vacuum the space IS reclaimed, so
-- the vacuumed index is within a small multiple of a freshly-built twin over the
-- SAME rows -- the leak-free property, asserted against a from-scratch build
-- rather than a hardcoded byte size / block number (which is environment-
-- dependent, e.g. a pinned-horizon reader defers reclaim and inflates any fixed
-- bound).  A genuine per-merge leak would not come back down under weave_vacuum.
SELECT weave_vacuum('recyc_bm25');
 weave_vacuum 
--------------
 t
(1 row)

SELECT pg_relation_size('recyc_bm25') AS recyc_vacuumed \gset
CREATE TABLE recyc_fresh (id serial, d wdoc);
INSERT INTO recyc_fresh (d) SELECT d FROM recyc ORDER BY id;
CREATE INDEX recyc_fresh_bm25 ON recyc_fresh USING weave (d);
SELECT pg_relation_size('recyc_fresh_bm25') AS recyc_fresh \gset
SELECT :recyc_vacuumed <= :recyc_fresh * 3 AS size_bounded;
 size_bounded 
--------------
 t
(1 row)

DROP TABLE recyc, recyc_fresh;
-- amcanorderbyop: ORDER BY col <=> query LIMIT k uses an index ordering scan.
CREATE TABLE ord (id serial, d wdoc);
INSERT INTO ord (d) VALUES
  (to_wdoc('quick quick quick fox')),   -- highest tf(quick)
  (to_wdoc('quick brown fox')),
  (to_wdoc('a slow turtle')),
  (to_wdoc('quick'));                    -- short doc, high length-norm score
CREATE INDEX ord_bm25 ON ord USING weave (d);
SET enable_seqscan = off;
-- the plan should be an index scan ordered by the distance operator (no Sort)
EXPLAIN (COSTS OFF)
SELECT id FROM ord WHERE d @@@ 'quick'::wquery
ORDER BY d <=> 'quick'::wquery LIMIT 2;
                   QUERY PLAN                    
-------------------------------------------------
 Limit
   ->  Index Scan using ord_bm25 on ord
         Index Cond: (d @@@ '''quick'''::wquery)
         Order By: (d <=> '''quick'''::wquery)
(4 rows)

-- results ordered by relevance (ascending distance)
SELECT id FROM ord WHERE d @@@ 'quick'::wquery
ORDER BY d <=> 'quick'::wquery LIMIT 3;
 id 
----
  1
  4
  2
(3 rows)

RESET enable_seqscan;
DROP TABLE ord;
-- On-disk trigram index: fuzzy/regex through the index over many docs.
-- The trigram funnel narrows candidates (sparsemap postings); recheck refines.
CREATE TABLE trgm (id serial, d wdoc);
INSERT INTO trgm (d) SELECT to_wdoc('document' || g) FROM generate_series(1, 1000) g;
INSERT INTO trgm (d) VALUES (to_wdoc('documemt42'));   -- id 1001, 1 edit from document42
CREATE INDEX trgm_bm25 ON trgm USING weave (d);
SET enable_seqscan = off;
-- fuzzy: finds the exact 'document42' (id 43: 'document42') and the typo (1001)
SELECT count(*) AS fuzzy_via_trigram
FROM trgm t WHERE t.d @@@ 'document42~2'::wquery;
 fuzzy_via_trigram 
-------------------
               424
(1 row)

-- regex through the trigram index
SELECT count(*) AS regex_via_trigram
FROM trgm t WHERE t.d @@@ '/document4[0-9]$/'::wquery;
 regex_via_trigram 
-------------------
                10
(1 row)

-- regex with alternation/anchors: literal-run tiling extracts 'document'
SELECT count(*) AS regex_anchored
FROM trgm t WHERE t.d @@@ '/^document(4|5)2$/'::wquery;   -- document42, document52
 regex_anchored 
----------------
              2
(1 row)

RESET enable_seqscan;
DROP TABLE trgm;
-- Adaptive-k ordering scan: consuming more than the initial batch (64) must
-- grow k and return the full ordered set correctly across the boundary.
CREATE TABLE bigord (id serial, d wdoc);
INSERT INTO bigord (d) SELECT to_wdoc('term extra' || (g % 3)) FROM generate_series(1, 300) g;
CREATE INDEX bigord_bm25 ON bigord USING weave (d);
SET enable_seqscan = off;
-- all 300 match 'term'; requesting 200 crosses the initial k=64 batch
SELECT count(*) AS got, bool_and(s >= lead_s) AS ordered_ok
FROM (SELECT r.score AS s, lead(r.score) OVER (ORDER BY r.score DESC) AS lead_s
      FROM (SELECT id, d <=> 'term'::wquery AS score FROM bigord
            WHERE d @@@ 'term'::wquery
            ORDER BY d <=> 'term'::wquery LIMIT 200) r) q;
 got | ordered_ok 
-----+------------
 200 | t
(1 row)

RESET enable_seqscan;
DROP TABLE bigord;
-- Ordering-scan completeness past the adaptive-k growth ceiling.  An ORDER BY
-- <=> index scan is a KNN (amcanorderbyop) scan and must return EVERY matching
-- tuple in score order -- it must not impose its own row ceiling (a prior fixed
-- cap silently truncated a query matching more than the cap to that cap; the
-- executor's LIMIT is the only bound).  5000 docs all match 'wide'; a large
-- LIMIT over the index ordering scan must yield all 5000, matching @@@.
CREATE TABLE bigord2 (id serial, d wdoc);
INSERT INTO bigord2 (d) SELECT to_wdoc('wide filler' || (g % 40)) FROM generate_series(1, 5000) g;
CREATE INDEX bigord2_bm25 ON bigord2 USING weave (d);
SET enable_seqscan = off;
SELECT count(*) AS match_truth FROM bigord2 WHERE d @@@ 'wide'::wquery;   -- 5000
 match_truth 
-------------
        5000
(1 row)

-- ordered index scan (bitmap disabled so the KNN Index Scan path is used) with
-- a LIMIT well past the old 4096 ceiling must still return all 5000
SET enable_bitmapscan = off;
SELECT count(*) AS ordered_scan_rows FROM
  (SELECT id FROM bigord2 WHERE d @@@ 'wide'::wquery
   ORDER BY d <=> 'wide'::wquery LIMIT 1000000) s;   -- 5000 (was capped ~4096)
 ordered_scan_rows 
-------------------
              5000
(1 row)

RESET enable_bitmapscan;
RESET enable_seqscan;
DROP TABLE bigord2;
