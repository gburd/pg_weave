-- admits only the 5 adjacent ones.
SELECT count(*) AS near3_matches FROM (
  SELECT d FROM rp WHERE d @@@ to_wquery('simple'::regconfig, 'NEAR(quick brown, 3)')
  ORDER BY d <=> to_wquery('simple'::regconfig, 'NEAR(quick brown, 3)') LIMIT 500
) s;
 near3_matches 
