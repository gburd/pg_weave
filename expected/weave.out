-- ============================================================================
-- Coverage: pg_weave_trgm.c -- weave_regex_trigrams metacharacter switch (every
-- case: backslash-escape, *, ?, +, {m,n}, |, (), [...], ., ^/$ anchors) and
-- weave_trigrams (short-term pad path, long-term dedup path).  Exercised both
-- via a WITH (trigrams=on) index (candidate-narrowing path,
-- weave_trgm_candidates) and directly against a sequential wdoc (the exact
-- weave_doc_has_regex / weave_doc_has_fuzzy recheck path, no index).
-- ============================================================================
CREATE TABLE trgmx (id serial, d wdoc);
INSERT INTO trgmx (d)
  SELECT to_wdoc('english',
           'abcdef quickbrownfox jumping settlement developer government ' ||
           'programmer environment establishment word' || (g % 250) ||
           ' filler text number ' || g)
  FROM generate_series(1, 220) g;
CREATE INDEX trgmx_idx ON trgmx USING weave (d) WITH (trigrams = on);
SET enable_seqscan = off;
-- backslash-escape: literal '.' via \. inside the pattern (case '\\')
SELECT count(*) >= 0 AS rx_escape FROM trgmx WHERE d @@@ '/abc\.def/'::wquery;
 rx_escape 
-----------
 t
(1 row)

-- star: previous char optional, run flushed and dropped (case '*')
SELECT count(*) >= 0 AS rx_star FROM trgmx WHERE d @@@ '/quickbrown.*fox/'::wquery;
 rx_star 
---------
 t
(1 row)

SELECT count(*) >= 0 AS rx_star_hit FROM trgmx WHERE d @@@ '/quickbrown[a-z]*fox/'::wquery;
 rx_star_hit 
-------------
 t
(1 row)

-- question mark: previous char optional (case '?')
SELECT count(*) >= 0 AS rx_opt FROM trgmx WHERE d @@@ '/developers?/'::wquery;
 rx_opt 
--------
 t
(1 row)

-- plus: previous char required, run flushed but kept (case '+')
SELECT count(*) >= 0 AS rx_plus FROM trgmx WHERE d @@@ '/programmer+/'::wquery;
 rx_plus 
---------
 t
(1 row)

-- brace quantifier, non-zero-capable {1,2} and zero-capable {0,2} (case '{')
SELECT count(*) >= 0 AS rx_brace_min1 FROM trgmx WHERE d @@@ '/governmentz{1,2}/'::wquery;
 rx_brace_min1 
---------------
 t
(1 row)

SELECT count(*) >= 0 AS rx_brace_min0 FROM trgmx WHERE d @@@ '/governmentz{0,2}/'::wquery;
 rx_brace_min0 
---------------
 t
(1 row)

-- alternation: drop the whole current run (case '|')
SELECT count(*) >= 0 AS rx_alt FROM trgmx WHERE d @@@ '/environment|nosuchword/'::wquery;
 rx_alt 
--------
 t
(1 row)

-- groups: flush at each boundary (case '(' / ')')
SELECT count(*) >= 0 AS rx_group FROM trgmx WHERE d @@@ '/(establish)ment/'::wquery;
 rx_group 
----------
 t
(1 row)

-- character class: not a fixed literal, flush and skip the whole [...] (case '[')
SELECT count(*) >= 0 AS rx_class FROM trgmx WHERE d @@@ '/develop[eE]r/'::wquery;
 rx_class 
----------
 t
(1 row)

-- character class with leading '^' (negated) and a literal ']' as first char
SELECT count(*) >= 0 AS rx_class_neg FROM trgmx WHERE d @@@ '/develop[^xyz]r/'::wquery;
 rx_class_neg 
--------------
 t
(1 row)

SELECT count(*) >= 0 AS rx_class_litbracket FROM trgmx WHERE d @@@ '/develop[]a]r/'::wquery;
 rx_class_litbracket 
---------------------
 t
(1 row)

-- wildcard dot: breaks the run (case '.')
SELECT count(*) >= 0 AS rx_dot FROM trgmx WHERE d @@@ '/gov.rnment/'::wquery;
 rx_dot 
--------
 t
(1 row)

-- anchors: run boundary, no char consumed (case '^' / '$')
SELECT count(*) >= 0 AS rx_anchor_start FROM trgmx WHERE d @@@ '/^abcdef/'::wquery;
 rx_anchor_start 
-----------------
 t
(1 row)

SELECT count(*) >= 0 AS rx_anchor_end FROM trgmx WHERE d @@@ '/abcdef$/'::wquery;
 rx_anchor_end 
---------------
 t
(1 row)

-- literal run shorter than a trigram (<3 required chars) -> no trigram
-- extracted, caller falls back to a full scan (still correct)
SELECT count(*) >= 0 AS rx_short_run FROM trgmx WHERE d @@@ '/ab/'::wquery;
 rx_short_run 
--------------
 t
(1 row)

-- literal run >= 3 chars -> a real required trigram is extracted
SELECT count(*) >= 0 AS rx_long_run FROM trgmx WHERE d @@@ '/abcd/'::wquery;
 rx_long_run 
-------------
 t
(1 row)

-- trailing lone backslash (no char after it within the pattern): the
-- tokenizer's regex reader stops at the first unescaped '/', so 'abc\/' with
-- one slash yields the pattern text "abc\" -- a backslash as the LAST byte,
-- hitting the "i + 1 < relen" false branch (case '\\', the else i++ arm).
-- The trailing lone backslash is an invalid regex to the recheck engine, so the
-- scan must ERROR cleanly (not crash): assert it raises rather than matches.
DO $$
BEGIN
  PERFORM count(*) FROM trgmx WHERE d @@@ '/abc\/'::wquery;
  RAISE NOTICE 'rx_trailing_backslash: no error';
EXCEPTION WHEN others THEN
  RAISE NOTICE 'rx_trailing_backslash: raised (expected for a trailing-backslash regex)';
END $$;
NOTICE:  rx_trailing_backslash: raised (expected for a trailing-backslash regex)
-- fuzzy terms of varied length: 1-2 chars (weave_trigrams pad path, len<3),
-- exactly 3 (single trigram, no dedup needed), and long (>=8, dedup path)
SELECT count(*) >= 0 AS fuzzy_len1 FROM trgmx WHERE d @@@ 'a~1'::wquery;
 fuzzy_len1 
------------
 t
(1 row)

SELECT count(*) >= 0 AS fuzzy_len2 FROM trgmx WHERE d @@@ 'ab~1'::wquery;
 fuzzy_len2 
------------
 t
(1 row)

SELECT count(*) >= 0 AS fuzzy_len3 FROM trgmx WHERE d @@@ 'abc~1'::wquery;
 fuzzy_len3 
------------
 t
(1 row)

SELECT count(*) >= 0 AS fuzzy_long FROM trgmx WHERE d @@@ 'developement~2'::wquery;
 fuzzy_long 
------------
 t
(1 row)

RESET enable_seqscan;
DROP TABLE trgmx;
