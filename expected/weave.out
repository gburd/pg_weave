-- ============================================================================
-- Coverage: BM25F NULL-element array paths + pushdown-rejection shapes
-- (pg_weave_rank.c per-field NULL handling; pg_weave_customscan.c gating)
-- ============================================================================
-- BM25F with NULL ELEMENTS inside the arrays (docnull/wnull/avgnull/dfs NULL):
-- a NULL doc field is skipped; NULL weight/avgdl default to 1.0; NULL dfs -> 1.0.
SELECT weave_bm25f(ARRAY[to_wdoc('postgres'), NULL]::wdoc[],
                 'postgres'::wquery, ARRAY[2.0,1.0], 100, ARRAY[1.0,1.0]) > 0 AS bm25f_null_field;
 bm25f_null_field 
------------------
 t
(1 row)

SELECT weave_bm25f(ARRAY[to_wdoc('postgres'), to_wdoc('body')],
                 'postgres'::wquery, ARRAY[NULL,1.0]::float8[], 100, ARRAY[1.0,1.0]) >= 0 AS bm25f_null_weight;
 bm25f_null_weight 
-------------------
 t
(1 row)

SELECT weave_bm25f(ARRAY[to_wdoc('postgres'), to_wdoc('body')],
                 'postgres'::wquery, ARRAY[2.0,1.0], 100, ARRAY[NULL,1.0]::float8[]) >= 0 AS bm25f_null_avgdl;
 bm25f_null_avgdl 
------------------
 t
(1 row)

SELECT weave_bm25f(ARRAY[to_wdoc('a b'), to_wdoc('c d')],
                 'a & c'::wquery, ARRAY[1.0,1.0], 100, ARRAY[2.0,2.0], ARRAY[NULL,3.0]::float8[]) >= 0 AS bm25f_null_dfs;
 bm25f_null_dfs 
----------------
 t
(1 row)

-- three fields; title (field 0) weighted heavily -> a title-only hit scores
-- higher than a body-only hit
SELECT weave_bm25f(ARRAY[to_wdoc('term'), to_wdoc('x'), to_wdoc('y')],
                 'term'::wquery, ARRAY[9.0,1.0,1.0], 100, ARRAY[1.0,1.0,1.0])
     > weave_bm25f(ARRAY[to_wdoc('x'), to_wdoc('y'), to_wdoc('term')],
                 'term'::wquery, ARRAY[9.0,1.0,1.0], 100, ARRAY[1.0,1.0,1.0]) AS bm25f_field_weight;
 bm25f_field_weight 
--------------------
 t
(1 row)

-- an empty wdoc field (doclen 0) is handled
SELECT weave_bm25f(ARRAY[to_wdoc(''), to_wdoc('term body')],
                 'term'::wquery, ARRAY[2.0,1.0], 100, ARRAY[1.0,2.0]) >= 0 AS bm25f_empty_field;
 bm25f_empty_field 
-------------------
 t
(1 row)

-- Count-pushdown rejection: shapes that must NOT push down (still correct).
CREATE TABLE psh (id serial, d wdoc, txt text);
INSERT INTO psh(d, txt) SELECT to_wdoc('english','term'||(g%4)||' body'), 'plain'||(g%3) FROM generate_series(1,200) g;
CREATE INDEX psh_idx ON psh USING weave (d);
CREATE INDEX psh_txt ON psh (txt);   -- a NON-weave index on the same rel
SET enable_seqscan = off;
-- @@@ with a NON-constant RHS (a subquery-derived value) -> RHS not a plan Const
SELECT count(*) FROM psh WHERE d @@@ (SELECT 'term1'::wquery);
 count 
-------
    50
(1 row)

-- two @@@ quals -> more than one qual, no single-@@@ pushdown
SELECT count(*) FROM psh WHERE d @@@ 'term1'::wquery AND d @@@ 'body'::wquery;
 count 
-------
    50
(1 row)

-- @@@ on a rel where the matched column also has a non-weave index (index-list walk)
SELECT count(*) FROM psh WHERE d @@@ 'term1'::wquery;
 count 
-------
    50
(1 row)

-- count over a rel with NO weave index at all (LHS has no matching weave index)
SELECT count(*) FROM psh WHERE txt = 'plain1';
 count 
-------
    67
(1 row)

RESET enable_seqscan;
DROP TABLE psh;
