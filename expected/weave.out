(1 row)

-- the bare count(*) plan is a Custom Scan (WeaveCount)
EXPLAIN (COSTS OFF) SELECT count(*) FROM cnt
  WHERE to_wdoc('english',body) @@@ to_wquery('english','common');
        QUERY PLAN        
--------------------------
 Custom Scan (WeaveCount)
(1 row)

-- an extra qual disables the pushdown (falls back to Aggregate over a scan)
EXPLAIN (COSTS OFF) SELECT count(*) FROM cnt
  WHERE to_wdoc('english',body) @@@ to_wquery('english','common') AND id > 5;
                                        QUERY PLAN                                        
------------------------------------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on cnt
         Recheck Cond: (to_wdoc('english'::regconfig, body) @@@ '''common'''::wquery)
         Filter: (id > 5)
         ->  Bitmap Index Scan on cnt_bm25
               Index Cond: (to_wdoc('english'::regconfig, body) @@@ '''common'''::wquery)
(6 rows)

RESET enable_seqscan;
