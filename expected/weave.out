-- Index-only BM25 top-k search (weave_search).
CREATE TABLE srch (id serial, body text, d wdoc);
INSERT INTO srch (body, d) VALUES
  ('quick quick quick fox', to_wdoc('quick quick quick fox')),
  ('quick brown fox', to_wdoc('quick brown fox')),
  ('a slow turtle', to_wdoc('a slow turtle')),
  ('quick', to_wdoc('quick'));
CREATE INDEX srch_bm25 ON srch USING weave (d);
-- top-k by index-only score: doc with tf(quick)=3 ranks first
SELECT s.id, round(r.score::numeric, 3) AS score
FROM weave_search('srch_bm25', 'quick'::wquery, 10) r
JOIN srch s ON s.ctid = r.ctid
ORDER BY r.score DESC, s.id;
