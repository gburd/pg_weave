# meson.build for pg_weave (Windows / MSVC out-of-tree build)
#
# The primary build path is the PGXS Makefile (Linux, macOS, *BSD). This
# meson recipe exists only for Windows/MSVC, where PostgreSQL itself is built
# with meson and PGXS is unavailable.
#
# PREREQUISITE: an MSVC-built PostgreSQL >= 17 built from source with the same
# Visual Studio toolchain (`meson setup ... && ninja install`). A
# MinGW/Strawberry PostgreSQL will NOT work: it ships a GCC-flavored pg_config.h
# that MSVC cannot consume, and no postgres.lib backend import library to link
# against.
#
# Build (from an "x64 Native Tools" prompt, or after vcvars64.bat):
#   meson setup build -Dpg_dir=C:/pgsql --buildtype=release
#   ninja -C build
#   ninja -C build install   # pg_weave.dll -> <pg>/lib, .control/.sql -> share/extension
#
# Note: build recipe only; the regress/isolation/TAP harness on Windows is
# separate PGXS-style plumbing, add when installcheck actually runs on Windows.

project('pg_weave', 'c',
  version: '0.1.0',
  default_options: ['c_std=c11', 'warning_level=2'])

fs = import('fs')
pg_dir = get_option('pg_dir')            # e.g. C:/pgsql (MSVC-built PG >= 17)

# A meson/nixpkgs-built PostgreSQL installs headers under
# include/postgresql/server and extension files under share/postgresql/extension;
# the older/MSVC layout uses include/server and share/extension. Detect which.
if fs.is_dir(pg_dir / 'include' / 'postgresql' / 'server')
  pg_include_server = pg_dir / 'include' / 'postgresql' / 'server'
  pg_extension_dir  = pg_dir / 'share' / 'postgresql' / 'extension'
else
  pg_include_server = pg_dir / 'include' / 'server'
  pg_extension_dir  = pg_dir / 'share' / 'extension'
endif
pg_lib = pg_dir / 'lib'

cc = meson.get_compiler('c')

# The backend import library. An MSVC PG build ships postgres.lib here.
postgres_lib = cc.find_library('postgres', dirs: [pg_lib], required: true)

incdirs = include_directories(
  pg_include_server,                     # <postgres.h>, fmgr.h, ...
  pg_include_server / 'port' / 'win32',  # win32 port shims
  pg_include_server / 'port' / 'win32_msvc',
  pg_dir / 'include',
  'include',                             # weave/*.h (RELAYOUT: headers moved here)
)

# Mirrors the Makefile OBJS list; keep the two in step.
sources = files(
  'src/query/analyze.c',
  'src/query/tsanalyze.c',
  'src/query/doc.c',
  'src/query/parse.c',
  'src/query/rank.c',
  'src/query/lev.c',
  'src/am/am.c',
  'src/am/ambuild.c',
  'src/am/amvacuum.c',
  'src/am/amscan.c',
  'src/am/customscan.c',
  'src/am/amaux.c',
  'src/am/amsize.c',
  'src/am/amcheck.c',
  'src/pages/trgm_page.c',
  'src/util/migrate.c',
  'src/query/trgm.c',
  'src/util/sparsemap.c',
  'src/query/match.c',
  # Fuzzy/regex/prefix channel, imported from pg_tre (doc/specs/IMPORT_pg_tre.md)
  # and wired into the build by tasks Z1/Z2.  Compiled and linked but not yet
  # reachable from the access method or the planner (Z3 onward).
  'src/query/fuzzy_guc.c',
  'src/query/hash.c',
  'src/query/surf.c',
  'src/query/surftrie.c',
  'src/query/uleven.c',
  'src/query/regex_ast.c',
  'src/query/regex_grammar.c',      # GENERATED by Lime from regex_grammar.y
  'src/query/regex_tokens.c',
  'src/query/parser.c',
  'src/query/extract.c',
  'src/query/tiling.c',
  'src/query/like_translate.c',
  'src/query/pattern_cache.c',
  'src/query/trgm_similarity.c',
  'src/util/utf8.c',
  # Vector channel.  These were MISSING from this list while present in the
  # Makefile's OBJS, so a meson build produced an .so with no wvec type and no
  # quantizer -- CREATE EXTENSION would have failed on an undefined symbol.  Two
  # build systems that disagree about which translation units exist is a broken
  # build system, not a stale comment, so keep this list and OBJS in step.
  # src/vector/graph.c is deliberately absent from both: it is a stub with no
  # callers (the graph tasks).  src/vector/vector.c used to be named here as the
  # other such stub and is GONE -- task V8 deleted it, because every symbol in it
  # except three GUC backing variables was a stale duplicate of a live one in
  # src/vector/wvec.c, which made a file that was one Makefile edit away from a
  # duplicate-symbol link error.  The three variables moved to kernel_ops.c.
  #
  # IT DRIFTED AGAIN, and the second time cost more than the first: vecweft.c and
  # vecwrite.c -- the vector weft's strip layout and the writer/reader that puts it
  # on pages, task V7 -- were in OBJS and not here, so a meson build had no weft
  # writer and no weft reader while the Makefile build had both.  Found while
  # adding vecscan.c (task V8).  A new src/vector/*.c goes in BOTH lists in the
  # same commit, and `git grep -c "src/vector" Makefile meson.build` is the
  # cheapest way to notice.
  'src/vector/quantize.c',
  'src/vector/pack.c',
  'src/vector/vecpage.c',
  'src/vector/vecweft.c',
  'src/vector/vecwrite.c',
  'src/vector/vecstats.c',
  'src/vector/vecscan.c',
  'src/vector/vecshuttle.c',
  'src/vector/kernels.c',
  'src/vector/kernel_ops.c',
  'src/vector/wvec.c',
)

# Vendored TRE (laurikari/tre @ f864ed0, BSD-2; see doc/LICENSING.md).  Built
# as ordinary translation units, not via TRE's autotools, so the two headers
# ./configure would have produced are checked in (vendor/tre/config.h and
# vendor/tre/local_includes/tre-config.h).  Mirrors libtre_la_SOURCES from
# vendor/tre/lib/Makefile.am with TRE_APPROX enabled.
#
# These get their own static_library() rather than joining `sources` because
# TRE's headers must NOT reach the rest of the build: local_includes/ would
# put a bare "tre.h" beside PostgreSQL's headers and vendor/tre/config.h would
# shadow any other <config.h>.  src/query/re_match.c is the one pg_weave file
# that needs them, so it is compiled here too.
tre_incdirs = include_directories(
  'vendor/tre',
  'vendor/tre/lib',
  'vendor/tre/local_includes',
)

tre_sources = files(
  'vendor/tre/lib/tre-ast.c',
  'vendor/tre/lib/tre-compile.c',
  'vendor/tre/lib/tre-match-approx.c',
  'vendor/tre/lib/tre-match-backtrack.c',
  'vendor/tre/lib/tre-match-parallel.c',
  'vendor/tre/lib/tre-mem.c',
  'vendor/tre/lib/tre-parse.c',
  'vendor/tre/lib/tre-stack.c',
  'vendor/tre/lib/regcomp.c',
  'vendor/tre/lib/regerror.c',
  'vendor/tre/lib/regexec.c',
)

# -DWIN32 + the CRT quiet macro; /wd4267 /wd4244 silence the size_t/__int64 ->
# int narrowing warnings exactly as PostgreSQL's own build suppresses them.
c_args = [
  '-DWIN32',
  '-D_CRT_SECURE_NO_WARNINGS',
  '/wd4267',
  '/wd4244',
]

# TRE is 2001-2009 C; /wd4018 /wd4101 /wd4996 quiet the signed/unsigned,
# unused-local and "insecure CRT function" complaints so re-pinning upstream
# never becomes a patch-the-warnings exercise.
tre_lib = static_library('tre',
  tre_sources + files('src/query/re_match.c'),
  include_directories: [tre_incdirs, include_directories('include')],
  c_args: c_args + ['-DHAVE_CONFIG_H', '/wd4018', '/wd4101', '/wd4996'],
)

pg_weave = shared_module('pg_weave',
  sources,
  include_directories: incdirs,
  dependencies: [postgres_lib],
  link_with: [tre_lib],
  c_args: c_args,
  name_prefix: '',                       # -> pg_weave.dll, not libpg_weave.dll
  install: true,
  install_dir: pg_lib,
)

# Control + SQL script into the extension dir (layout auto-detected above).
#
# EVERY script, not just the base.  pg_weave.control names a default_version for
# which there is no pg_weave--<default>.sql (0.8.0 when this was written, 0.11.0
# now) -- PostgreSQL reaches it by applying the
# upgrade chain from the 0.1.0 base.  Installing only the base therefore produced
# an extension that could not be created at its own default version ("extension
# \"pg_weave\" has no installation script nor update path for version 0.8.0").
# The Makefile's DATA has always listed the whole chain; this list drifted from it.
# Keep the two in step: a new sql/pg_weave--X--Y.sql goes in BOTH.
install_data('pg_weave.control', install_dir: pg_extension_dir)
install_data(
  'sql/pg_weave--0.1.0.sql',
  'sql/pg_weave--0.1.0--0.2.0.sql',
  'sql/pg_weave--0.2.0--0.3.0.sql',
  'sql/pg_weave--0.3.0--0.4.0.sql',
  'sql/pg_weave--0.4.0--0.5.0.sql',
  'sql/pg_weave--0.5.0--0.6.0.sql',
  'sql/pg_weave--0.6.0--0.7.0.sql',
  'sql/pg_weave--0.7.0--0.8.0.sql',
  'sql/pg_weave--0.8.0--0.9.0.sql',
  'sql/pg_weave--0.9.0--0.10.0.sql',
  'sql/pg_weave--0.10.0--0.11.0.sql',
  install_dir: pg_extension_dir,
)
